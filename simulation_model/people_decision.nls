;; @file people_decision.nls
;; @brief Choosing an activity, and the small questions that choice depends on.
;;
;; This file sits between the list of activities a person could do
;; (`select_activity.nls`) and the scoring of those activities
;; (`need_management.nls`): it picks the winner, and answers the calendar and
;; dependency questions - is today a working day, is a child in my care, should I
;; be staying home - that shape both.
;;
;; @see decision/select_activity.nls
;; @see need_management.nls
;; @see docs/WIP_ISSUES.md

__includes ["need_management.nls" "country_specific_features/cultural_model.nls" "decision/quarantining.nls" "decision/select_activity.nls"]

;; The activity this person most wants to do, of those open to them now.
;;
;; Every available descriptor is scored by `global-prevalence-of` and the highest
;; wins. The candidates are shuffled first, so that equal scores are broken at
;; random rather than by list order.
;;
;; @context person
;; @return an activity descriptor
;; @side-effects prints the chosen place and motive on every call
;; @see global-prevalence-of
;; @see my-available-activity-descriptors
to-report my-preferred-available-activity-descriptor 
  ;if log-preferred-activity-decision? [ log-file-print (sentence "Person " who " " age)]

  let preferred-activity-descriptor item 0 reduce [[x y] -> ifelse-value item 1 x > item 1 y [x] [y]] shuffle (map [x -> (list x (global-prevalence-of x))] my-available-activity-descriptors)
  
  let activity-place location-of preferred-activity-descriptor
  let place-type [gathering-type] of activity-place
  print (sentence "my preferred available activity descriptor is" place-type " " motive-of preferred-activity-descriptor)

  report preferred-activity-descriptor
  ;print (sentence "my preferred available activity descriptor is" item 0 reduce [[x y] -> ifelse-value item 1 x > item 1 y [x] [y]] shuffle (map [x -> (list x (global-prevalence-of x))] my-available-activity-descriptors))
  ;report item 0 reduce [[x y] -> ifelse-value item 1 x > item 1 y [x] [y]] shuffle (map [x -> (list x (global-prevalence-of x))] my-available-activity-descriptors)
end


;; Whether today is a working day, asked either of a person or of a place.
;;
;; For a place: stores follow shop opening hours, everywhere else works Monday to
;; Friday. For a person: workers inherit the answer from their workplace, everyone
;; else works Monday to Friday. Anything that is neither a person nor a gathering
;; point raises an error.
;;
;; @context person or gathering-point
;; @return true if today is a working day for the caller
;; @side-effects raises an error if called from any other context
;; @see is-shops-open-today?
to-report is-working-day-for-me?
  if is-gathering-point? self [ ifelse is-store? [report is-shops-open-today?] [report not (day-of-the-week = "saturday" or day-of-the-week = "sunday")]]
  
  if is-person? self 
  [
    if is-worker? [report [is-working-day-for-me?] of my-work]
    report not (day-of-the-week = "saturday" or day-of-the-week = "sunday")
  ]
  
  error (sentence "wrong user of this function" self [age] of self)
end

;; Whether shops trade today.
;;
;; @return true on every day except Sunday
to-report is-shops-open-today?
  report not (day-of-the-week = "sunday")
end

;; The motive recorded when a person leaves the country.
;;
;; @return `travelling-motive`
;; @note A thin alias for `travelling-motive`, used by the migration branch of
;; `my-available-activity-descriptors`, which is currently commented out.
to-report travelling-reason
  report travelling-motive
end

;; True when this person needs somebody to look after them today.
;;
;; A child whose school is shut has to follow an adult around; that is what
;; `perform-people-activities` uses this for.
;;
;; @context person
;; @return true if this person is a child and schools are closed
;; @note Never true in the current build: `is-child?` tests `age`, which nothing
;; assigns.
to-report is-currently-in-situation-of-active-dependence?
  report is-child? and closed-schools?
end

;; Whether this person is under any instruction to stay at home right now.
;;
;; @context person
;; @return true under hard lockdown, under an official quarantine order, or during
;; curfew hours
;; @note Two of the three routes are COVID-era: the Ebola model activates neither
;; lockdown nor curfew, so in practice only the quarantine order can fire.
to-report should-I-stay-home?
  if is-hard-lockdown-active? [report true]
  if is-officially-asked-to-quarantine? [report true]
  if is-curfew-active? and (is-evening? or is-night?) [report true]
  report false
end


;; Work in progress.
;;
;; work in progress
;;
;; @context work in progress
;; @return work in progress
;; @todo Tests for gathering types the Ebola build does not create. See
;; docs/WIP_ISSUES.md#is-technically-feasible-to-work-from-home-.
to-report is-technically-feasible-to-work-from-home?
  if not is-worker? [error "not a worker"]
  report member? [gathering-type] of my-work ["workplace" "university"]
  ;link-neighbors with [gathering-type = "workplace"]
end

;; True when a child is present wherever this person currently is.
;;
;; @context person
;; @return true if any child shares this person's current gathering point
;; @note Never true in the current build: `is-child?` tests `age`, which nothing
;; assigns.
to-report is-currently-watching-a-child?
  report any? [current-gatherers with [is-child?]] of current-activity
end

;; True when an adult is present wherever this person currently is.
;;
;; @context person
;; @return true if any adult shares this person's current gathering point
;; @note Never true in the current build: `is-adult?` tests `age`, which nothing
;; assigns.
to-report is-currently-watched-by-an-adult?
  report any? [current-gatherers with [is-adult?]] of current-activity
end

;; Refresh how long it has been since this person saw each part of their network.
;;
;; Seeing your relatives, colleagues or friends means more than half of that group
;; being in the same place as you; when that happens the corresponding
;; "days since seen" counter resets to zero. Colleagues also pass on the knowledge
;; that working from home is possible.
;;
;; @context person
;; @side-effects resets `days-since-seen-relatives`, `days-since-seen-colleagues`
;; and `days-since-seen-friends`, and may set `I-know-of-working-from-home?`
;; @note The counters are reset here but nothing increments them, and the call to
;; `update-memory` at the end is commented out.
to update-belief-based-on-current-activity
  let family-here count my-relatives with [current-activity = [current-activity] of myself]
  if any? my-relatives and family-here / count my-relatives > 0.5 [ set days-since-seen-relatives 0 ]
  
  if is-worker? 
  [
    let colleagues-here count my-colleagues with [current-activity = [current-activity] of myself]
    if (any? other my-colleagues and colleagues-here / count my-colleagues > 0.5) [ set days-since-seen-colleagues 0 ]
    if any? other my-colleagues with [I-know-of-working-from-home?] [ set I-know-of-working-from-home? true ]
  ]

  let friends-here count my-friends with [current-activity = [current-activity] of myself]
  if any? my-friends and friends-here / count my-friends > 0.5 [ set days-since-seen-friends 0 ]
  ;if any? other my-network with [I-know-of-social-distancing?] [ set I-know-of-social-distancing? true ]
  
  ;update-memory
end

;; Work in progress.
;;
;; work in progress
;;
;; @context work in progress
;; @side-effects work in progress
;; @todo Fully written but never called: its call site is commented out. See
;; docs/WIP_ISSUES.md#update-memory.
to update-memory
  let network-activities new-counter
  if count my-network > 0 [
    ask my-network [
      set network-activities add-to-counter network-activities (list [gathering-type] of current-activity current-motivation)
    ]
  
    let network-activity counter-max-value network-activities
    ifelse is-working-day-for-me? [
      set what-my-network-did-week-day lput network-activity what-my-network-did-week-day
      if length what-my-network-did-week-day > 4 [
        set what-my-network-did-week-day but-first what-my-network-did-week-day
      ]
    ] [
      set what-my-network-did-weekend lput network-activity what-my-network-did-weekend
      if length what-my-network-did-weekend > 4 [
        set what-my-network-did-weekend but-first what-my-network-did-weekend
      ]
    ]
    set did-my-network-socially-distance? 2 * count (my-network with [is-I-apply-social-distancing?]) >= count my-network
    let quarantine-network my-network with [is-officially-asked-to-quarantine?]
    ifelse any? quarantine-network [
      set did-my-network-quarantine? 2 * count (quarantine-network with [is-in-quarantine?]) >= count quarantine-network
    ] [
      set did-my-network-quarantine? false
    ]
  ]
end
