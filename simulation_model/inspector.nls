globals [
  inspector-file
  inspected-female
  inspected-male
]

to setup-agent-inspector
  set inspector-file "inspector"
  if behaviorspace-experiment-name != "" [
    set inspector-file (word inspector-file "_" behaviorspace-experiment-name)
  ]
  set inspector-file (word inspector-file "_run" behaviorspace-run-number ".csv")
  if inspect-to-file? [
    set inspected-female one-of female-agentset
    set inspected-male one-of male-agentset
    
    if file-exists? inspector-file [ file-delete inspector-file ]
    file-open inspector-file
    file-print "who, sex, time, day, health, location, people-at-location"
    file-close
  ]
end

to inspect-agents
  if inspect-to-file? [
    if inspected-female = nobody and any? female-agentset [ set inspected-female one-of female-agentset ]
    if inspected-male = nobody and any? male-agentset [ set inspected-male one-of male-agentset ]

    file-open inspector-file
    if inspected-female != nobody [
      ask inspected-female   [ inspect-agent ]
    ]
    if inspected-male != nobody [
      ask inspected-male [ inspect-agent ]
    ]
    file-close
  ]
end

to inspect-agent
  file-print (word
    who ","
    sex ","
    slice-of-the-day ","
    day-of-the-week ","
    infection-status ","
    [gathering-type] of current-activity ","
    ([count current-gatherers] of current-activity) ","
    )
end