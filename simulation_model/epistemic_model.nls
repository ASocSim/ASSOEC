to radio-dissemination
ask radios[
;;the messages of radio channels are set by the government
;;they spread to a set of agents (random for now) every evening
let speaker one-of radios ;turn to agentset
let listener one-of people
let belief-set broadcast-hospital ;(list broadcast-hospital broadcast-medicine broadcast-ebola broadcast-SDB)
let message belief-set ;one-of
let government -1
;send-message( speaker listener message government)
]
end


