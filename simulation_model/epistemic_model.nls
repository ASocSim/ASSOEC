;this must be expanded and reworked
;stigma is big influence - beliefs on ebola, trust in healthcare
;affect behaviour on funeral rites and likelihood of acknowledging disease + going to hospital

;Fear-driven behavioral change coefficient; dual effect:
;reduces treatment-seeking AND increases clustering in home/funeral settings
;how to model trust ; Trust (set of) parameter in ABM
;higher mistrust = lower compliance with isolation/burial imposed rules
;community-led intervention = higher trust coefficient

;;modelling radios as hubs - they spread information relative to institutional directives
;;however, the effect depends on the listeners previous beliefs:
;;if someone is low on trust, listening to radio may cause further lowering of trust
;;if someone is ambivalent, they can be influenced either way (this should depend on who is there)
;modeling this at civil societies only for now

globals
[
  ;globals prep, not used
  #ebola-business-believers
  #ratio-willing-to-trust-hospital
  #ratio-willing-to-trust-institutional-advice
  ;let ebola-business-narrative-value mean [my-trust-in-institutions] of current-gatherers
  ;print ebola-business-narrative-value 
]


to spread-information
;;converge opinions within households
  ask homes [influence-relatives]
;;model radio via civil societic
  ask civil-societies [radio-dissemination]
;;churches
 ask churches [influence-congregation]

end


to influence-relatives
  let home-id self
  let residents people with [my-home = home-id] 
  ask residents
  [
    ;;calculate the mean
    let mean-trust-in-hospital mean ([my-trust-in-hospital] of residents)
    let mean-trust-in-institutions mean ([my-trust-in-institutions] of residents)

    ;;converge within households
    ifelse my-trust-in-hospital < mean-trust-in-hospital [
        set my-trust-in-hospital my-trust-in-hospital + 0.01 ;will make dynamic later
      ][set my-trust-in-hospital my-trust-in-hospital - 0.01]
;cap
      if my-trust-in-hospital < 0 [set my-trust-in-hospital 0]
      if my-trust-in-hospital > 1 [set my-trust-in-hospital 1]

    ifelse my-trust-in-institutions < mean-trust-in-institutions [
        set my-trust-in-institutions my-trust-in-institutions + 0.01 ;will make dynamic later
      ][set my-trust-in-institutions my-trust-in-institutions - 0.01]
;cap
      if my-trust-in-institutions < 0 [set my-trust-in-institutions 0]
      if my-trust-in-institutions > 1 [set my-trust-in-institutions 1]
  ]
end




to radio-dissemination
;this only happens at civil societies
;;first check how different our opinions are
;;polarizing
if any? current-gatherers [
;;here it gets probabilistic
ask current-gatherers[
  ifelse my-trust-in-institutions >= 0.5
  [set my-trust-in-institutions my-trust-in-institutions + 0.01]
  [set my-trust-in-institutions my-trust-in-institutions - 0.01]
 ]
]
end




to influence-congregation
;;for the baseline, the priest's individual belief will be propagated to the congregation
let priests hired-workers with [priest?]
let congregation current-gatherers

  ask priests
  [
    ;;this can be influenced in scenarios
    ifelse my-trust-in-institutions >= 0.5 
    [
    ask congregation 
     [set my-trust-in-institutions my-trust-in-institutions + 0.01
     ]]
     [
    ask congregation 
      [set my-trust-in-institutions my-trust-in-institutions - 0.01
     ]

     ;cap
      if my-trust-in-institutions < 0 [set my-trust-in-institutions 0]
      if my-trust-in-institutions > 1 [set my-trust-in-institutions 1]

    ]
  ]

end


;;;;REPORTERS;;;;;;


to-report not-going-to-unsafe-burials
;threshold level at 98% to not go to unsafe burials
;;only people with near absolute trust in government institutions will choose not to attend a dear one funeral
  if my-trust-in-institutions >= 0.98[
    report true
  ]
    report false
end

to-report unwilling-to-go-hospital
;threshold level at 85% to not go to hospital under any circumstance determined by needs or social influence
  if my-trust-in-hospital <= 0.15[
    report true
  ]
    report false
end





to-report believes-ebola-business?
  report epistemic-status = "ebola business"
end


;incorporates the belief that "I can infect others"
to-report sick-with-ebola
  report epistemic-status = "I am sick with ebola"
end

to-report sick-with-other-disease
  report epistemic-status = "I am sick but not with ebola"
end

to-report ebola-is-survivable
  report epistemic-status = "I can survive"
end




to update-epistemic-status

;keep track of people who die or survive via hospitals
;update their networks beliefs

;;if relative died at hospital, reduce trust
;;stronger effect for housemates
if infection-status = hospitalised-to-dead-infectious-infection-status
[ 
  ask my-housemates[
    set my-trust-in-hospital my-trust-in-hospital - 0.4
    ;cap
      if my-trust-in-hospital < 0 [set my-trust-in-hospital 0]
  ]
  ask my-network[
    set my-trust-in-hospital my-trust-in-hospital - 0.1
    ;cap
      if my-trust-in-hospital < 0 [set my-trust-in-hospital 0]
  ]
     ; print (sentence "telling my network of" count my-network "people that I died")

]

;;if relative recovered via hospital, increase trust
if infection-status = hospitalised-to-immune-infection-status
[
  ask my-housemates[
    set my-trust-in-hospital my-trust-in-hospital + 0.4
    ;cap
      if my-trust-in-hospital < 0 [set my-trust-in-hospital 0
      set epistemic-status "ebola-is-survivable"]

  ]
ask my-network[
    set my-trust-in-hospital my-trust-in-hospital - 0.1
    ;cap
      if my-trust-in-hospital < 0 [set my-trust-in-hospital 0
          set epistemic-status "ebola-is-survivable"]

  ]
       ; print (sentence "telling my network of" count my-network "people that I survived")

]



;let deceased people know they are dead  
   if infection-status = "dead" [
     set epistemic-status "dead"
     stop
   ]



;if agent believes ebola is a business, they interpret their sickness as some other disease
    if believes-ebola-business? and is-observing-critical-symptoms?
     [
       set epistemic-status "sick-with-other-disease"
     ]

    if not believes-ebola-business? and is-observing-critical-symptoms?
     [
       set epistemic-status "sick-with-ebola"
     ]


    
end
