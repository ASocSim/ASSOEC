
to-report my-available-activity-descriptors
    
  ;add resting at home for SLEEP need
  ;now the people actually go to their own home to sleep
  let activities (list (list my-home rest-motive))

  if someone-died? 
  [
    set activities []
    set activities (lput (activity-descriptor funeral-cemetery funeral-motive) activities)

    print (sentence "someone died, so I go to funeral" funeral-cemetery)

    let ret []
    foreach activities [ activity ->
      set ret fput (lput false activity) ret
  ]
  report ret
  ]
  
 ; set activities lput (list my-hospital "get treatment") activities

  

  ;get food
  ;from store any day except sundays
   if ( slice-of-the-day = "morning" or slice-of-the-day = "afternoon" and day-of-the-week != "sunday")
    [
      set activities (lput (activity-descriptor my-store food-motive ) activities)
    ]

  ;get food
  ;from markets on any afternoon 
  if slice-of-the-day = "afternoon"
    [
      set activities (lput (activity-descriptor my-market food-motive) activities)
    ]

  ;work motive
  ;work during the week
  if (slice-of-the-day = "morning" or slice-of-the-day = "afternoon") and is-working-day-for-me?
  [
      set activities (lput (activity-descriptor my-work work-motive) activities)
      
      ;print (sentence "working day for me:" is-working-day-for-me? " my work is" [gathering-type] of my-work " my motive is" work-motive)
  ]  
  
  
  ;attend religious gathering,
  ;on sunday we can go to religious gathering 
  if (day-of-the-week = "sunday" and slice-of-the-day = "morning" or slice-of-the-day = "afternoon") [
    set activities (lput (activity-descriptor my-church spiritual-motive) activities)]
  
  ;organize funeral
  if someone-died?
  [
    set activities (lput (activity-descriptor funeral-cemetery funeral-motive) activities)
  ]
  
  ;get treatment
;; THIS NEEDS TO BE EXPANDED FOR THE PIVOTAL CHOICE OF GOING TO HOSPITAL OR NOT
;  if has-internally-visible-symptoms? or is-believing-to-be-infected?
  ;epistemic logic conditional here
 ; [ set activities lput activity-descriptor my-hospital treatment-motive activities ]
  ;[ set activities lput activity-descriptor my-home treatment-motive activities ]
  
  
  ;care for the sick
  ;if i have a sick relative, and I am female, I care for them (at home)
  ;if any? my-relatives      [set activities lput (activity-descriptor my-home "care for the sick") activities]
  ;logic here for hospital caring
  
  
  ;visits
  if slice-of-the-day = "evening" or not is-working-day-for-me?  
  [
    ;visit my own home
    set activities lput (activity-descriptor one-of homes social-motive) activities
    ;print "i go to visit family"
  ]
 
  

;;hacky funeral test
;;if someone dies, all activities are replaced by funeral activity, and the person goes to the funeral
;;justification: if someone dies, the funeral is the most important activity, people cancel plans to attend

  
 ; set activities lput (list my-hospital "get treatment") activities

  let ret []
  foreach activities [ activity ->
    set ret fput (lput false activity) ret
  ]
  report ret
end

to select-activity
  let c-a my-preferred-available-activity-descriptor

  let loc location-of c-a
  let motive motive-of c-a
  let schedule-entry (list loc motive slice-of-the-day day-of-the-week)
  set schedule lput schedule-entry schedule
  ;print (sentence "my preferred activity is" c-a)
  ;;select if migration takes over and people move around
;   if (migration? and random-float 1 < probability-going-abroad) [
;       print "hello after if sats"
;     set c-a (list away-gathering-point travelling-motive false)
;   ]

  select-activity-wtf? loc
  set current-activity loc
  set current-motivation motive-of c-a

 ; if current-activity != away-gathering-point and current-motivation = travelling-motive [error "wrong place while travelling"]
  
end

;;this function is the main bottleneck of the whole application!
;;it draws 0.2ms per call 
to select-activity-wtf? [loc]
 ; set is-moving-outside-for-reaching-current-activity? not (current-activity = location-of c-a)
  set is-moving-outside-for-reaching-current-activity? not (current-activity = loc)
end
