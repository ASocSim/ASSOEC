<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="false">
  <code><![CDATA[extensions [profiler table]
__includes [ "setup/setup-ebola.nls" "people_management.nls" "global_metrics.nls" "environment_dynamics.nls" "animation.nls" "validation/testing.nls" "utils/all_utils.nls" "inspector.nls" ]
breed [people person]

globals [
  slice-of-the-day
  day-of-the-week
  is-lockdown-active?
  current-day
 ;keep for now
  #dead-people
  #dead-retired
  #dead-workers
  #dead-students
  #dead-young
  away-gathering-point
  #who-became-sick-while-travelling-locally
  import-scenario-name
  someone-died?
  funeral-cemetery
]


to go
  set someone-died? false
  ;set funeral-cemetery one-of cemeteries
  
  reset-timer
  reset-metrics
;  reset-economy-measurements
  ;rumor-mill ;define later how mis/information spreads  
  spread-contagion
  
  update-within-agent-disease-status
  
  update-people-mind
  
  ;destruction-event ;Periodic facility destruction events in ABM; capacity shock; reduction in effective isolation beds; security parameter limits RRT deployment --> driven by internal state (collective)
  perform-people-activities

  update-display
  ;inspect-agents
  increment-time
 ; apply-active-measures
  update-metrics
  set someone-died? false
  ; Tick goes at the end of the go procedure for better plot updating
  tick
end

to go-profile
  profiler:reset
  profiler:start

  repeat 10 [go]
  export-profiling
end


to startup
  setup-ebola

end


;workaround, refactor and move later
to-report is-currently-being-treated-at-home?
  report people with [infection-status != "susceptible"]
end

to-report epistemic-accuracy if #infected = 0 [report 1] report count people with [is-infected? and is-believing-to-be-infected?] / #infected end

to-report epistemic-false-positive-error-ratio report count people with [is-believing-to-be-infected? and not is-infected?] / count people end

to-report epistemic-error-of-ignored-immunity-ratio report count people with [not is-believing-to-be-immune? and not is-immune?] / count people end
  ]]></code>
