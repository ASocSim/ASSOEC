    <experiment name="S6" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="1500">
      <setup>setup-ebola
set preset-scenario "scenario-6-default"
load-scenario-specific-parameter-settings</setup>
      <go>go</go>
