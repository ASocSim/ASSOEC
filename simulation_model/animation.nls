;; @file animation.nls
;; @brief Everything the view shows: where the places are, and where the people
;; standing at them are drawn.
;;
;; Coordinates carry no meaning for the model - no decision anywhere reads an
;; `xcor` - so this file is free to arrange the world for legibility. It does two
;; things:
;;
;; 1. `layout-gathering-points`, once at the end of setup, cuts the world into one
;;    district per kind of place, tints and labels each district, and arranges that
;;    kind's places on an even grid inside it. Nothing is placed at random, so the
;;    same world always looks the same and a place can be found by where it is.
;; 2. `update-display`, at the end of every tick, colours people by disease state
;;    and puts each of them on the place their `current-activity` names, packed into
;;    rings around it. A crowd therefore reads as a crowd and still sits on top of
;;    its place rather than beside it.
;;
;; With `animate?` on, step 2 walks people across the world a patch at a time and
;; refreshes the view between steps; with it off they are moved straight there.
;;
;; @see setup/setup-ebola.nls
;; @see gathering_points.nls

;#region Per-tick display

;; Refresh everything the view shows: how people look, and where they stand.
;;
;; @context observer
;; @side-effects sets `color` on every person, and moves every person onto their
;; `current-activity`
;; @see update-people-display
;; @see move-people-to-their-activities
to update-display
  ask people [update-people-display]
  move-people-to-their-activities
  update-social-link-visibility
end

;; Show or hide the social network, following the `show-social-links?` switch.
;;
;; The friendship and dependency networks are drawn over everything else and, once
;; people are spread across the world, cover it in a web that hides the districts
;; underneath. They are therefore off unless asked for. Re-applied every tick rather
;; than once at setup, so the switch takes effect without a rebuild.
;;
;; @context observer
;; @side-effects hides or shows every social link
to update-social-link-visibility
  ifelse show-social-links?
  [ ask my-friends-links [show-link] ask dependable-adult-links [show-link] ]
  [ ask my-friends-links [hide-link] ask dependable-adult-links [hide-link] ]
end

;; Colour this person by sex, lightened while they are still susceptible.
;;
;; @context person
;; @side-effects sets `color`
;; @see default-color
to update-people-display
  set size person-marker-size
  set color default-color
  if infection-status = susceptible-infection-status
  [set color color + 2]
  if is-infected?
  [set color color ]
  if infection-status = hospitalised-to-immune-infection-status
  [set color white]
end

;; The colour this person is drawn in before disease state is taken into account.
;;
;; @context person
;; @return green for women, red for men
to-report default-color
  if sex = "female" [report green]
  if sex = "male" [report red]
   if age = "young" [report blue]
;   if age = "student" [report orange]
;   if age = "worker" [report blue]
;   if age = "retired" [report red]
end

;#endregion

;#region Moving people onto their gathering point

;; Put every person on the place they are currently at.
;;
;; Each person is given a slot in the crowd standing at their `current-activity`,
;; which fixes the exact spot they belong on; they then either walk there or are
;; moved straight there, depending on `animate?`.
;;
;; @context observer
;; @side-effects moves every person, and sets their display target
;; @see assign-crowd-positions
;; @see walk-people-to-their-positions
to move-people-to-their-activities
  assign-crowd-positions
  ifelse animate?
  [ walk-people-to-their-positions ]
  [ ask people [setxy display-target-xcor display-target-ycor] ]
end

;; Work out the exact spot each person belongs on, and record it on them.
;;
;; People are handed their slot in the order they sort in, so that somebody keeps
;; the same spot from one tick to the next for as long as the same crowd is around
;; them and the view does not reshuffle for nothing.
;;
;; A person whose activity is not a place - which should not happen, but does not
;; deserve a crash in display code - is left where they already are.
;;
;; @context observer
;; @side-effects sets `display-target-xcor` and `display-target-ycor` on every
;; person, and resets `crowd-slots-taken` on every gathering point
;; @see crowd-offset
to assign-crowd-positions
  ask gathering-points [set crowd-slots-taken 0]

  foreach sort people [ a-person ->
    ask a-person [
      ifelse is-gathering-point? current-activity
      [
        let slot 0
        ask current-activity [
          set slot crowd-slots-taken
          set crowd-slots-taken crowd-slots-taken + 1
        ]
        let shift crowd-offset slot
        set display-target-xcor (clamped min-pxcor max-pxcor ([xcor] of current-activity + first shift))
        set display-target-ycor (clamped min-pycor max-pycor ([ycor] of current-activity + last shift))
      ]
      [
        set display-target-xcor xcor
        set display-target-ycor ycor
      ]
    ]
  ]
end

;; Where the person holding slot `slot` in a crowd stands, relative to the place.
;;
;; Slots fill outwards in rings around the place, six slots to the first ring and
;; six more to each ring after it. Slot 0 is on the first ring rather than dead
;; centre, so that the marker for the place itself stays visible under the crowd.
;; Rings stop growing at `max-crowd-radius`, which keeps a large gathering from
;; spilling over its neighbours.
;;
;; @param slot  the person's index in the crowd, counting from 0
;; @return the offset from the place, as a two-element list (dx, dy)
;; @see crowd-ring-slots
to-report crowd-offset [slot]
  let ring 1
  let index slot
  while [index >= crowd-ring-slots ring] [
    set index index - crowd-ring-slots ring
    set ring ring + 1
  ]

  let angle 360 * index / crowd-ring-slots ring
  let radius min (list max-crowd-radius (crowd-ring-spacing * ring))
  report (list (radius * sin angle) (radius * cos angle))
end

;; How many people stand on ring `ring` of a crowd.
;;
;; @param ring  the ring, counting from 1
;; @return a count of slots
to-report crowd-ring-slots [ring]
  report 6 * ring
end

;; How far apart the rings of a crowd are.
;;
;; @return a distance in patches
to-report crowd-ring-spacing
  report 0.4 * display-scale
end

;; How far from its place a crowd is allowed to spread.
;;
;; Chosen against the district grids in `layout-gathering-points`: it is under half
;; the spacing between two places of the same kind, so two crowds never merge.
;;
;; @return a distance in patches
to-report max-crowd-radius
  report 1.2 * display-scale
end

;#endregion

;#region Walking

;; Walk everybody to their display target, a step at a time, refreshing the view.
;;
;; Only used when `animate?` is on. The step budget is what a person needs to cross
;; the world twice; anybody it does not cover is put on their target anyway, so
;; that nobody is left stranded between two places.
;;
;; @context observer
;; @side-effects moves people, and refreshes the view repeatedly
;; @see animation-step-length
to walk-people-to-their-positions
  let walkers people with [not is-at-display-target?]
  let steps-left #max-animation-steps

  while [any? walkers and steps-left > 0] [
    ask walkers [
      facexy display-target-xcor display-target-ycor
      forward min (list animation-step-length distancexy display-target-xcor display-target-ycor)
    ]
    display
    wait animation-frame-delay
    set walkers people with [not is-at-display-target?]
    set steps-left steps-left - 1
  ]

  ask people [setxy display-target-xcor display-target-ycor]
end

;; True when this person has arrived where they are being drawn.
;;
;; @context person
;; @return true if they are within a hundredth of a patch of their display target
to-report is-at-display-target?
  report distancexy display-target-xcor display-target-ycor < 0.01 * display-scale
end

;; How far a walking person moves per animation step.
;;
;; @return a distance in patches
to-report animation-step-length
  report 1 * display-scale
end

;; How long the view is left up between two animation steps.
;;
;; @return a delay in seconds
to-report animation-frame-delay
  report 0.03
end

;; How many steps a walk may take before people are simply put where they belong.
;;
;; @return a count of steps, enough to cross the world twice at `animation-step-length`
to-report #max-animation-steps
  report 2 * (world-width + world-height)
end

;#endregion

;#region Display scale

;; How many patches one drawing unit is worth in the world as it is cut now.
;;
;; Nothing the view draws is a fixed number of patches. The world is cut fine so
;; that districts can be given lanes and headers a few patches wide, which would
;; otherwise leave every marker, crowd ring and walking step three times too small.
;; They are all written as multiples of this instead, so the display keeps its size
;; on screen and resizing the world needs no constant retuned.
;;
;; One unit is what a patch was worth in the 21-patch world the model was first
;; drawn for.
;;
;; @return a distance in patches
to-report display-scale
  report world-width / 21
end

;; How large a place is drawn, before `arrange-on-grid` shrinks it to fit its cell.
;;
;; @return a size in patches
;; @see arrange-on-grid
to-report place-marker-size
  report 1 * display-scale
end

;; How large a person is drawn.
;;
;; @return a size in patches
to-report person-marker-size
  report 0.5 * display-scale
end

;#endregion

;#region The district layout

;; Arrange every place in the world into one district per kind of place.
;;
;; The residential quarter takes the left of the world, since there are more homes
;; than anything else; the right is split into two columns and four rows, which
;; gives the eight other kinds of place a district each, paired by what they are
;; for - work at the top, then trade, then the civic places, and at the bottom the
;; two places people end up at when things go wrong.
;;
;; Every district is separated from its neighbours by a lane of `district-gutter`
;; patches painted `district-lane-color`, so no two districts ever share a border
;; patch and the seam between them is visible rather than inferred from a change of
;; tint. Each district is then tinted, given a header strip carrying its name, and
;; its places are spread over an even grid filling the rest of it.
;;
;; Any kind of place with no district of its own - the `away` placeholder, and
;; leisure venues if they are ever built - is put along the top margin.
;;
;; Must run after `create-all-households`, or the homes will not exist yet to be
;; placed.
;;
;; @context observer
;; @side-effects moves and resizes every gathering point, and repaints and relabels
;; every patch
;; @see place-district
;; @see arrange-on-grid
to layout-gathering-points
  ask patches [set pcolor district-lane-color set plabel ""]

  ; the world minus a one-patch margin, which is where the strays go
  let left-edge min-pxcor + 1
  let right-edge max-pxcor - 1
  let bottom-edge min-pycor + 1
  let top-edge max-pycor - 1

  ; the residential quarter, then a lane, then two equal service columns
  let quarter-edge left-edge + round (0.42 * (right-edge - left-edge))
  let column-a band-bounds (quarter-edge + 1 + district-gutter) right-edge 2 0
  let column-b band-bounds (quarter-edge + 1 + district-gutter) right-edge 2 1

  let row-1 band-bounds bottom-edge top-edge 4 0
  let row-2 band-bounds bottom-edge top-edge 4 1
  let row-3 band-bounds bottom-edge top-edge 4 2
  let row-4 band-bounds bottom-edge top-edge 4 3

  (place-district home-gathering-type "HOMES"
    left-edge quarter-edge bottom-edge top-edge green)

  (place-district workplace-mine-gathering-type "MINES"
    (first column-a) (last column-a) (first row-4) (last row-4) brown)
  (place-district workplace-agriculture-gathering-type "FARMS"
    (first column-b) (last column-b) (first row-4) (last row-4) lime)

  (place-district stores-gathering-type "SHOPS"
    (first column-a) (last column-a) (first row-3) (last row-3) yellow)
  (place-district markets-gathering-type "MARKETS"
    (first column-b) (last column-b) (first row-3) (last row-3) orange)

  (place-district school-gathering-type "SCHOOLS"
    (first column-a) (last column-a) (first row-2) (last row-2) pink)
  (place-district churches-gathering-type "CHURCHES"
    (first column-b) (last column-b) (first row-2) (last row-2) sky)

  (place-district hospital-gathering-type "HOSPITALS"
    (first column-a) (last column-a) (first row-1) (last row-1) turquoise)
  (place-district cemeteries-gathering-type "CEMETERIES"
    (first column-b) (last column-b) (first row-1) (last row-1) violet)

  let strays gathering-points with [not member? gathering-type districted-gathering-types]
  arrange-on-grid strays left-edge right-edge max-pycor max-pycor
end

;; The kinds of place `layout-gathering-points` gives a district of their own.
;;
;; @return a list of `gathering-type` strings
to-report districted-gathering-types
  report ["home" "workplace-mine" "workplace-agriculture" "store" "market"
          "school" "church" "hospital" "cemetery"]
end

;; Tint one district, write its name on it, and fill it with its places.
;;
;; The district body is painted four shades below `hue`, dark enough for the place
;; markers standing on it to read; the top `district-header-height` rows are painted
;; a shade and a half below `hue` instead, which makes a title bar in the district's
;; own colour. The name goes on that bar, and the places are arranged over what is
;; left below it, so a marker can never end up underneath the name.
;;
;; The name is anchored towards the header's *right* edge, not its left: NetLogo
;; right-justifies a patch label against the patch's right edge and draws it upwards
;; from the patch's bottom, so anchoring on the right makes the name grow inwards
;; into its own district instead of spilling across the neighbouring one. It sits
;; `district-label-margin` in from the bottom and the right of the strip, which is
;; what keeps the glyphs off the places below and off the lane beside.
;;
;; @param gps            the places belonging to this district
;; @param district-name  the name drawn on the district's header strip
;; @param x0             leftmost patch column of the district
;; @param x1             rightmost patch column
;; @param y0             bottom patch row
;; @param y1             top patch row
;; @param hue            the district's colour, as a NetLogo base colour
;; @context observer
;; @side-effects repaints and labels patches, and moves and resizes the places
;; @see arrange-on-grid
to place-district [gps district-name x0 x1 y0 y1 hue]
  ask patches with [pxcor >= x0 and pxcor <= x1 and pycor >= y0 and pycor <= y1] [
    set pcolor hue - 4
  ]

  let header-bottom max (list y0 (y1 - district-header-height + 1))
  ask patches with [pxcor >= x0 and pxcor <= x1 and pycor >= header-bottom and pycor <= y1] [
    set pcolor hue - 1.5
  ]

  ask patch (max (list x0 (x1 - district-label-margin))) (min (list y1 (header-bottom + district-label-margin))) [
    set plabel district-name
    set plabel-color black
  ]

  arrange-on-grid gps x0 x1 y0 (max (list y0 (header-bottom - 1)))
end

;; Spread `gps` evenly over the rectangle, one place per cell of an even grid.
;;
;; The grid is as square as the rectangle allows: the number of columns is chosen so
;; that the cells come out roughly as wide as they are tall. Each place is put at the
;; *centre* of its cell rather than on the grid lines, which keeps every marker at
;; least half a cell clear of the rectangle's border and so inside its own district.
;;
;; Markers are also shrunk to fit: a place is never drawn wider than four fifths of
;; the smaller side of its cell, so a district holding many places packs tighter
;; instead of overlapping. Places are taken in `who` order, so a district always
;; fills the same way.
;;
;; @param gps  the places to arrange; may be empty
;; @param x0   leftmost patch column of the rectangle
;; @param x1   rightmost patch column
;; @param y0   bottom patch row
;; @param y1   top patch row
;; @context observer
;; @side-effects moves and resizes every place in `gps`
;; @see place-marker-size
to arrange-on-grid [gps x0 x1 y0 y1]
  let #places count gps
  if #places = 0 [stop]

  ; the rectangle measured to the outer edges of its border patches
  let usable-width x1 - x0 + 1
  let usable-height y1 - y0 + 1
  let #columns min (list #places (max (list 1 (ceiling sqrt (#places * usable-width / usable-height)))))
  let #rows ceiling (#places / #columns)

  let column-spacing usable-width / #columns
  let row-spacing usable-height / #rows

  ask gps [
    set size min (list place-marker-size (0.8 * min (list column-spacing row-spacing)))
  ]

  let index 0
  foreach sort gps [ a-place ->
    let column index mod #columns
    let row floor (index / #columns)
    ask a-place [
      setxy (x0 - 0.5 + (column + 0.5) * column-spacing)
            (y1 + 0.5 - (row + 0.5) * row-spacing)
    ]
    set index index + 1
  ]
end

;; The bounds of band `index` when `lo`..`hi` is cut into `#bands` equal bands
;; separated by lanes.
;;
;; Bands are whole patches wide: rounding is done on the cuts rather than on the
;; widths, so no row is ever left over or counted twice. Every band but the last
;; then gives up its top `district-gutter` rows, which is what leaves a lane between
;; one district and the next.
;;
;; @param lo      first patch row or column of the range
;; @param hi      last patch row or column
;; @param #bands  how many bands to cut it into
;; @param index   which band is wanted, counting from 0
;; @return a two-element list, (first row or column, last row or column)
to-report band-bounds [lo hi #bands index]
  let band-size (hi - lo + 1) / #bands
  let band-start lo + round (index * band-size)
  let band-end lo + round ((index + 1) * band-size) - 1
  if index < #bands - 1 [set band-end band-end - district-gutter]
  report (list band-start (max (list band-start band-end)))
end

;; How wide the lane between two districts is.
;;
;; Measured in pixels rather than patches - a lane is there to be seen, and how many
;; patches that takes depends on how finely the world is cut.
;;
;; @return a count of patches, at least one
to-report district-gutter
  report max (list 1 (round (6 / patch-size)))
end

;; How many rows at the top of a district are given over to its name.
;;
;; The view draws labels in a fixed point size, so the strip has to be however many
;; patches cover a line of that text, plus the `district-label-margin` row the text
;; is lifted off the bottom of the strip by.
;;
;; @return a count of patches, at least one
to-report district-header-height
  report max (list 1 (ceiling (15 / patch-size))) + district-label-margin
end

;; How far a district's name is inset from the bottom and right of its header strip.
;;
;; Without it the glyphs sit flush against the places below the strip and against
;; the lane beside it, and read as touching both.
;;
;; @return a count of patches, at least one
to-report district-label-margin
  report max (list 1 (round (4 / patch-size)))
end

;; The colour of the lanes between districts, and of the margin around them.
;;
;; Lighter than any district body, so a district edge reads as an edge.
;;
;; @return a NetLogo colour
to-report district-lane-color
  report gray - 2
end

;#endregion

;; Restrict `value` to the closed range [`low`, `high`].
;;
;; @param low    lower bound
;; @param high   upper bound
;; @param value  the value to restrict
;; @return `value`, pinned to the nearest bound if it lies outside the range
to-report clamped [low high value]
  report min (list high (max (list low value)))
end
