  #delivered-supply-proposed-this-tick
  when-has-2%-infected-threshold-first-been-met?
  when-has-5%-infected-threshold-first-been-met?
  #contacts-last-tick
  
  first-infected-people
  #first-infected-people;;needed as infected people can die
  #infected-by-first-infected-people
  #infected-by-asymptomatic-people

   
  #contacts-in-pubtrans
  #contacts-in-shared-cars
  #contacts-in-queuing
  #contacts-in-general-travel
  
  #people-infected-in-pubtrans
  #people-infected-in-shared-cars
  #people-infected-in-queuing
  #people-infected-in-general-travel

  #people-infected-in-hospitals
  #people-infected-in-mines
  #people-infected-in-homes
  #people-infected-in-markets
  #people-infected-in-churches
  #people-infected-in-schools
  #people-infected-in-agriculture
  #people-infected-in-stores

  #people-infected-in-away-travel
  
  #cumulative-females-infected
  #cumulative-males-infected
  #cumulative-females-infector
  #cumulative-males-infector
  #females-at-start
  #males-at-start
  #hospitalizations-females-this-tick
  #hospitalizations-males-this-tick
 
  #contacts-in-hospitals
  #contacts-in-workplaces
  #contacts-in-homes
  #contacts-in-markets
  #contacts-in-churches
  #contacts-in-schools
  #contacts-in-stores
  #contacts-in-mines
  #contacts-in-agriculture
  
  sex-group-to-sex-group-#contacts-table

  sex-group-to-sex-group-cumulated-#contacts-table
  sex-group-to-sex-group-#infections-last-tick-table
  
  number-of-people-per-sex-having-ever-reached-severe-table
  contamination-network-table
  #infected-people-per-ticks
  #hospitalized-per-tick
]

to-report ratio-infected
  report #infected / count people
end

to-report ratio-infected-female
  if #females-at-start > 0 [report #cumulative-females-infected / #females-at-start]
  report 0
end

to-report ratio-infected-male
  if #males-at-start > 0 [report #cumulative-males-infected / #males-at-start]
  report 0
end


to update-metrics
  set #infected-times-ticks #infected-times-ticks + #infected
  
  if ratio-infected > 0.02 and when-has-2%-infected-threshold-first-been-met? = "never"
  [set when-has-2%-infected-threshold-first-been-met? ticks]

  if ratio-infected > 0.05 and when-has-5%-infected-threshold-first-been-met? = "never"
  [set when-has-5%-infected-threshold-first-been-met? ticks]
end


to reset-metrics
  set #admissions-last-tick 0 
  set #delivered-supply-proposed-this-tick 0
  set #contacts-last-tick 0
  
  set #contacts-in-pubtrans 0
  set #contacts-in-shared-cars 0
  set #contacts-in-queuing 0
  set #contacts-in-general-travel 0
  
  set #contacts-in-hospitals 0
  set #contacts-in-markets 0
  set #contacts-in-homes 0
  set #contacts-in-churches 0
  set #contacts-in-mines 0
  set #contacts-in-schools 0
  set #contacts-in-stores 0
  set #contacts-in-agriculture 0
  
  set #hospitalizations-females-this-tick 0
  set #hospitalizations-males-this-tick 0
  ;set #hospitalizations-boys-this-tick 0
  ;set #hospitalizations-girls-this-tick 0
  
    ;;reset sex-group-to-sex-group-#contacts-table
  foreach all-sexes [ [x] -> foreach all-sexes [ [y] -> table:put sex-group-to-sex-group-#contacts-table (list x y) 0]]
  foreach all-sexes [ [x] -> foreach all-sexes [ [y] -> table:put sex-group-to-sex-group-#infections-last-tick-table (list x y) 0]]
  foreach all-sexes [ [x] -> table:put sex-group-to-sex-group-#infections-last-tick-table (list "nobody" x) 0 ]
  
  set #infected-people-per-ticks lput #infected #infected-people-per-ticks
  set  #hospitalized-per-tick lput #taken-hospital-beds   #hospitalized-per-tick    
  
end


 to increment-sex-infection-information-metrics [infected infector]
   if [sex = female-sex] of infected [set #cumulative-females-infected #cumulative-females-infected + 1]
   if [sex != female-sex] of infected [set #cumulative-males-infected #cumulative-males-infected + 1]
;   if [age = worker-age] of infected [set #cumulative-workers-infected #cumulative-workers-infected + 1]
;   if [age = retired-age] of infected [set #cumulative-retireds-infected #cumulative-retireds-infected + 1]
  
   if infector != nobody [
     if [sex = female-sex] of infector [set #cumulative-females-infector #cumulative-females-infector + 1]
     if [sex != female-sex] of infector [set #cumulative-males-infector #cumulative-males-infector + 1]
;     if [age = worker-age] of infector [set #cumulative-workers-infector #cumulative-workers-infector + 1]
;     if [age = retired-age] of infector [set #cumulative-retireds-infector #cumulative-retireds-infector + 1]  
   ]
 end

to increment-hospitalizations-global-metrics
  if sex = female-sex [set #hospitalizations-females-this-tick #hospitalizations-females-this-tick + 1]
  if sex != female-sex [set #hospitalizations-males-this-tick #hospitalizations-males-this-tick + 1]
;  if age = worker-age [set #hospitalizations-workers-this-tick #hospitalizations-workers-this-tick + 1]
 ; if age = retired-age [set #hospitalizations-retired-this-tick #hospitalizations-retired-this-tick + 1]
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;Update the classes for ebola HERE
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report #people-at-start
  report #females-at-start + #males-at-start ; + #boys-at-start + #girls-at-start
end

to-report ratio-of-females-at-start
  report #females-at-start / #people-at-start
end


to-report ratio-of-males-at-start
  report #males-at-start / #people-at-start
end

; to-report ratio-of-boys-at-start
;   report #boys-at-start / #people-at-start
; end
  
; to-report ratio-of-girls-at-start
;   report #girls-at-start / #people-at-start
; end

to-report ratio-sex-group-to-sex-group-#infections [infector-sex infected-sex]
  report table:get sex-group-to-sex-group-#infections-last-tick-table (list infector-sex infected-sex) / #initial-people-with-sex infected-sex
end


to add-to-contagion-tree [infector infectee context]
  if contamination-network-table = 0 [set contamination-network-table table:make] 
  let key infector
  ifelse infector != nobody 
  [set key [who] of infector]
  [set key "nobody"]
  
  if not table:has-key? contamination-network-table key [table:put contamination-network-table key (list)]
  table:put contamination-network-table key lput (list [who] of infectee ticks context)  table:get contamination-network-table key
end


to increment-contagion-metrics-from [context infected infector]
  increment-sex-infection-information-metrics infected infector
  
  let key []
  ifelse infector != nobody [
    set key (list [sex] of infector [sex] of infected)
  ] [
    set key (list "nobody" [sex] of infected)
  ]
  table:put sex-group-to-sex-group-#infections-last-tick-table key table:get sex-group-to-sex-group-#infections-last-tick-table key + 1  
  
    if is-gathering-point? context [
    let gt [gathering-type] of context
    if gt = hospital-gathering-type [set #people-infected-in-hospitals #people-infected-in-hospitals + 1 stop]
    if gt = workplace-mine-gathering-type [set #people-infected-in-mines  #people-infected-in-mines + 1 stop]
    if gt = workplace-agriculture-gathering-type [set #people-infected-in-agriculture  #people-infected-in-agriculture + 1 stop]
    if gt = home-gathering-type [set #people-infected-in-homes #people-infected-in-homes + 1 stop]
    if gt = churches-gathering-type [set #people-infected-in-churches #people-infected-in-churches + 1 stop]
    if gt = school-gathering-type [set #people-infected-in-schools #people-infected-in-schools + 1 stop]  
    if gt = markets-gathering-type [set #people-infected-in-markets #people-infected-in-markets + 1 stop]  
    if gt = stores-gathering-type [set #people-infected-in-stores #people-infected-in-stores + 1 stop]  
  ]
  
  if context = "bus" [set #people-infected-in-pubtrans #people-infected-in-pubtrans + 1 stop]
  if context = "queue-waiting-for-bus" [set #people-infected-in-queuing #people-infected-in-queuing + 1 stop]
  if context = "cars" [set #people-infected-in-shared-cars #people-infected-in-shared-cars + 1 stop]
  if context = "travelling outside" [set #people-infected-in-general-travel #people-infected-in-general-travel + 1 stop]
  if context = "away" [set #people-infected-in-away-travel #people-infected-in-away-travel + 1 stop]
  error (sentence "unimplemented for" context)
end

to increment-#contacts-per-gathering-type-global-metrics [ts context]
  let #contacts-now (count ts * (count ts - 1))
  if is-gathering-point? context [
    let gt [gathering-type] of context
    print gt
    
    if gt = hospital-gathering-type [set #contacts-in-hospitals #contacts-in-hospitals + #contacts-now stop]
    if gt = workplace-mine-gathering-type [set #contacts-in-mines #contacts-in-mines + #contacts-now stop]
    if gt = workplace-agriculture-gathering-type [set #contacts-in-agriculture #contacts-in-agriculture + #contacts-now stop]  
    if gt = home-gathering-type [set #contacts-in-homes #contacts-in-homes + #contacts-now stop]
    if gt = stores-gathering-type [set #contacts-in-stores #contacts-in-stores + #contacts-now stop]  
    if gt = school-gathering-type [set #contacts-in-schools #contacts-in-schools + #contacts-now stop]  
    if gt = markets-gathering-type [set #contacts-in-markets #contacts-in-markets + #contacts-now stop]  
    if gt = churches-gathering-type [set #contacts-in-churches #contacts-in-churches + #contacts-now stop]  
  ]
  
  if context = "bus" [set #contacts-in-pubtrans #contacts-in-pubtrans + #contacts-now stop]
  if context = "queue-waiting-for-bus" [set #contacts-in-queuing #contacts-in-queuing + #contacts-now stop]
  if context = "cars" [set #contacts-in-shared-cars #contacts-in-shared-cars + #contacts-now stop]
  if context = "travelling outside" [set #contacts-in-general-travel #contacts-in-general-travel + #contacts-now stop]
  error (sentence "unimplemented for" context)
end

to  increment-contacts-due-to-group-gathering-global-metrics [ts context]
  increment-#contacts-per-gathering-type-global-metrics ts context
  ask ts [
    ask other ts [
      let key (list [sex] of myself sex)
;      if sex = female-sex and [sex] of myself = female-sex
      table:put sex-group-to-sex-group-#contacts-table key table:get sex-group-to-sex-group-#contacts-table key + 1
      if not table:has-key? sex-group-to-sex-group-cumulated-#contacts-table key [ table:put sex-group-to-sex-group-cumulated-#contacts-table key 0]
      table:put sex-group-to-sex-group-cumulated-#contacts-table key table:get sex-group-to-sex-group-cumulated-#contacts-table key + 1
    ]
  ] 
end

to-report ratio-quarantiners-currently-complying-to-quarantine
  if count people with [is-officially-asked-to-quarantine?] = 0 [report 0]
  report count people with [is-officially-asked-to-quarantine? and is-in-quarantine?] / count people with [is-officially-asked-to-quarantine?]
end

to increase-people-being-severe-event-global-metrics [p]
  table:put number-of-people-per-sex-having-ever-reached-severe-table [age] of p (table:get number-of-people-per-sex-having-ever-reached-severe-table [age] of p + 1)
end

to-report ratio-people-having-ever-reached-severe-infection-status [a]
  report table:get number-of-people-per-sex-having-ever-reached-severe-table a / #initial-people-with-sex a
end

to-report #initial-people-with-sex [a]
  if a = female-sex [report    #females-at-start]
  if a = male-sex [report    #males-at-start]
;  if a = worker-age [report    #workers-at-start]
;  if a = retired-age [report    #retireds-at-start]
end

to-report sex-group-to-sex-group-#contacts [infector-sex infected-sex]
  report table:get sex-group-to-sex-group-#contacts-table (list infector-sex infected-sex)
end

to-report peak-number-of-infected
  report max #infected-people-per-ticks
end

