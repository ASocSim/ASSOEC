;;;;;;;;EBOLA;;;;;;;;;;;;;;;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report female-sex
  report "female"
end

to-report females
  report people with [is-female?]
end


to-report male-sex
  report "male"
end

to-report males
  report people with [is-male?]
end


to-report all-sexes
  report (list female-sex male-sex)
end

;;LEGACY COVID;;;;;; might use

to-report is-parent?
  report is-worker? and any? my-housemates with [is-young?]
end

to-report parents
  report people with [is-parent?]
end


to-report young-age
   report "young"
 end

to-report youngs
  report people with [is-young?]
end


