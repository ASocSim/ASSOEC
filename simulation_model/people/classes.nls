;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to-report female-sex
  report "female"
end

to-report female-agentset
  report people with [is-female?]
end


to-report male-sex
  report "male"
end

to-report male-agentset
  report people with [is-male?]
end


to-report all-sexes
  report (list female-sex male-sex)
end

