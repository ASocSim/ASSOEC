    ;;;;;;;;;;;;;;;;;;EBOLA - cumulative SURVIVAL needs ;;;;;;;;;;;;;;;;;;

;; We model survival in its subgroups of food, sleep, financial, and health
;; FOOD includes water and is procured as a day activity at markets or stores, getting food increases health but damages finances
;; SLEEP is only replenished by the action motive "rest"
;; FINANCIAL survival is replenished by working (in mine, agriculture, shop, hospital, or church) not housework
;;;;a person who is sick and getting treatment at home or hospital depleats financial survival
;; HEALTH ( maybe be redundant )
;;;;as workers in Mongbwalu are not storing large amounts of food at home and need to work for daily survival, the available rations are always NULL or the amount of capital is minimal TBD
;;;;only procuring food replenishes Health
;;;;food in hospital is not a given, so if a patient is being treated, their health satisfaction is also low - this links to people's desire to visit relatives in hospitals

;;financial stability is not present explicitly in Ebola model




to-report SDE-survival [ad]
  let physiological-needs (list 
    SDE-food ad 
    SDE-health ad
    SDE-sleep ad  
    SDE-financial-survival ad
  )
  report max physiological-needs
end



    ;;;;;;;;;;;;;;;;;;EBOLA BELONGING NEEDS;;;;;;;;;;;;;;;;;;
;;; belonging is split in family and group
to-report SDE-social [ad]
  let social-needs (list 
    SDE-group-belonging ad 
    SDE-family-belonging ad
  )
  report max social-needs
end



    ;;;;;;;;;;;;;;;;;;EBOLA SAFETY MODS;;;;;;;;;;;;;;;;;;

;;Safety for now is physical social safety, others can be added later
;;;;SOCIAL SAFETY is increased by attending religious gatherings(weekend) and visiting relatives (evenings)
;;;; women's social safety decreases if they are getting treatment in a hospital
;;;; COMPLIANCE AND RISK AVOIDANCE are not in the ebola model

to-report SDE-safety [ad]
  
  let psychological-needs (list
    (SDE-social-safety ad)
    (SDE-physical-safety ad)
  )
  report max psychological-needs 
  
end


    ;;;;;;;;;;;;;;;;;;EBOLA SELF ESTEEM MODS;;;;;;;;;;;;;;;;;;
;; for covid these were leisure, luxury and autonomy. For Ebola, these are SOCIAL STATUS, AUTONOMY and PROVIDE FOR FAMILY (patriarcal)

;; SOCIAL STATUS is also grown by working and evening leisure activities, and depleats with treatment at hospital (maybe)
;; AUTONOMY concerns self determination through tradition and culture, it is also increased by working and decreased by SDB and getting treatment at hospital
;;;; leisure and luxury are part of autonomy in ebola model
;; PROVIDING is replenished by working in mine, agriculture, shop, hospital, or church, and housework
;;;;getting treatment depleats this

to-report SDE-self-esteem [ad]
  let needs (list 
  SDE-providing ad
  SDE-social-status ad
  SDE-autonomy ad)
  
  report max needs
end
