    ;;;;;;;;;;;;;;;;;;EBOLA MODEL MODS;;;;;;;;;;;;;;;;;;
    ;;;;;;;;;;;;;;;;;;EBOLA - SAFETY;;;;;;;;;;;;;;;;;;
;;Safety for now is physical social safety, others can be added later
;;;;SOCIAL SAFETY is increased by attending religious gatherings(weekend) and visiting relatives (evenings)
;;;; women's social safety decreases if they are getting treatment in a hospital
;;;; COMPLIANCE AND RISK AVOIDANCE are not in the ebola model

to-report SDE-safety [ad]
  ; Using min here the value is always zero (food can only go up when they go to the store, but that lowers compliance/risk avoidance).
  ; The actual solution is to fully recalculate what safety would be after doing the action based on the satisfaction-gains calculated,
  ;  pick the lowest one, and take the difference between that and current satisfaction
  
  let psychological-needs (list
    (SDE-social-safety ad)
    (SDE-physical-safety ad)
  )
  let importances-psychological-needs (list importance-weight-social-safety importance-weight-physical-safety)

  report weighted-mean psychological-needs importances-psychological-needs
  
end


    ;;;;;;;;;;;;;;;;;;EBOLA MODEL MODS;;;;;;;;;;;;;;;;;;
    ;;;;;;;;;;;;;;;;;;EBOLA - SELF ESTEEM;;;;;;;;;;;;;;;;;;

;; for covid these were leisure, luxury and autonomy. For Ebola, these are SOCIAL STATUS, AUTONOMY and PROVIDE FOR FAMILY (patriarcal)

;; SOCIAL STATUS is also grown by working and evening leisure activities, and depleats with treatment at hospital (maybe)
;; AUTONOMY concerns self determination through tradition and culture, it is also increased by working and decreased by SDB and getting treatment at hospital
;;;; leisure and luxury are part of autonomy in ebola model
;; PROVIDING is replenished by working in mine, agriculture, shop, hospital, or church, and housework
;;;;getting treatment depleats this

to-report SDE-self-esteem [ad]
  let needs (list 
  SDE-providing ad
  SDE-social-status ad
  SDE-autonomy ad)
  let importances (list importance-weight-providing importance-weight-autonomy importance-weight-social-status)
  
  report weighted-mean needs importances
end



to-report quality-of-life-indicator
  
  let quality-of-life (list 
      ;Survival needs
    (food-satisfaction-level * importance-weight-food) 
    (financial-survival-satisfaction-level * importance-weight-financial-survival)
    (sleep-satisfaction-level * importance-weight-sleep) 
    (health-satisfaction-level * importance-weight-health) 
    ;Self-Esteem needs
    (social-status-satisfaction-level * importance-weight-social-status)
    (providing-satisfaction-level * importance-weight-providing)
    (autonomy-satisfaction-level * importance-weight-autonomy)
    ;Safety needs
    (physical-safety-satisfaction-level * importance-weight-physical-safety) 
    (social-safety-satisfaction-level * importance-weight-social-safety) 
    ;Belonging needs
    (group-belonging-satisfaction-level * importance-weight-group-belonging)
    (family-belonging-satisfaction-level * importance-weight-family-belonging))
 
  report sum quality-of-life
end

