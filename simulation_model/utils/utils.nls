;; @file utils/utils.nls
;; @brief Small helpers that the model itself does not depend on.
;;
;; Extra mathematics, string handling, a counter "datastructure", and the
;; debugging and world-import/export commands wired to the interface buttons.
;;
;; @see all_utils.nls

;; The mean of `values`, each weighted by the entry at the same position of `weights`.
;;
;; @param values   list of numbers
;; @param weights  list of weights, the same length as `values`
;; @return the weighted mean
;; @example
;; weighted-mean [1 2] [1 3]  ;; => 1.75
to-report weighted-mean [values weights]
  report (sum (map [ [v w] -> v * w] values weights)) / sum weights
end

;; Map `val` linearly from the input range onto the output range.
;;
;; Values outside the input range are pinned to the nearest output bound, so the
;; result never leaves [`min-map`, `max-map`].
;;
;; @param min-val  lower bound of the input range
;; @param max-val  upper bound of the input range
;; @param min-map  value reported for `min-val` and anything below it
;; @param max-map  value reported for `max-val` and anything above it
;; @param val      the value to map
;; @return the mapped value
;; @see clamp
to-report bounded-linear-map [min-val max-val min-map max-map val]
  if val < min-val [report min-map]
  if val > max-val [report max-map]
  report (val - min-val) / (max-val - min-val) * (max-map - min-map) + min-map
end


;; Restrict `number` to the closed range [`low`, `high`].
;;
;; @param low     lower bound
;; @param high    upper bound
;; @param number  the value to restrict
;; @return `number`, or the bound it exceeded
;; @see clamp-soft
to-report clamp [low high number]
  if number < low [
    report low
  ]
  if number > high [
    report high
  ]
  report number
end

;; Squash a number into the open interval (0, 1), never quite reaching either end.
;;
;; Based on a Gompertz function, so the result grows slowly for small inputs and
;; flattens out towards 1.
;;
;; @param number  the value to squash
;; @return a value strictly between 0 and 1
;; @see clamp
to-report clamp-soft [number]
  report exp(-5 * exp(-4 * number))
end


;; Stop the profiler and write its report to `report.log` next to the model.
;;
;; @context observer
;; @side-effects replaces any existing `report.log`
to export-profiling
  profiler:stop
  let _fname "report.log"
  carefully [file-delete _fname] []
  file-open _fname
  file-print profiler:report
  file-close
end

;; Ask the user for a file to export the world to, through a save dialog.
;;
;; @context observer
;; @side-effects sets the global `import-scenario-name`
;; @see save-world-state
to ask-user-for-export-file
    set import-scenario-name user-new-file
end

;; Ask the user for a world file to import, through an open dialog.
;;
;; @context observer
;; @side-effects sets the global `import-scenario-name`
;; @see load-scenario-from-file
to ask-user-for-import-file
  set import-scenario-name user-file
end

;; Export the whole world to the file named by `import-scenario-name`.
;;
;; Prints a message and stops when no file has been chosen yet.
;;
;; @context observer
;; @side-effects writes a NetLogo world export file
;; @see ask-user-for-export-file
to save-world-state
  ; Need to check for = false to not throw errors on normal string output
  if import-scenario-name = false or import-scenario-name = "" [
    print "No file selected for import"
    stop
  ]
  ;if not file-exists? import-scenario-name [ show "sometimes the file needs to be created by hand first"]
  export-world import-scenario-name
end

;; Replace the world with the one stored in `import-scenario-name`.
;;
;; Prints a message and stops when no file has been chosen yet.
;;
;; @context observer
;; @side-effects discards the current world state
;; @see ask-user-for-import-file
to load-scenario-from-file
  if import-scenario-name = false or import-scenario-name = "" [
    print "No file selected"
    stop
  ]
  import-world import-scenario-name
end

;; Whether `string` begins with `start` and is strictly longer than it.
;;
;; @param string  the string to test
;; @param start   the prefix to look for
;; @return true when `string` starts with `start`, false otherwise
to-report starts-with? [string start]
   report  length string > length start and substring string 0 length start = start
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;; Counter "datastructure" ;;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; An empty counter.
;;
;; A counter tallies how often each object appears; it works on anything that
;; supports `=`. It is a list of count-pairs, so it can be stored in an agent
;; variable and exported with the world.
;;
;; @return a counter with nothing counted yet
;; @see add-to-counter
;; @see count-in-list
to-report new-counter
  report []
end

;; Tally every element of a list.
;;
;; @param l  the list to count
;; @return a counter holding the occurrences of each element of `l`
;; @see counter-get-count
to-report count-in-list [l]
  let counter new-counter
  foreach l [ elem ->
    set counter add-to-counter counter elem
  ]
  report counter
end

;; The count-pairs of `counter`, ordered by the counted object rather than by count.
;;
;; @param counter  the counter to sort
;; @return a sorted list of count-pairs
to-report counter-sort-on-element [counter]
  report sort-by [ [x y] -> item 0 x < item 0 y] counter
end

;; Count one more occurrence of `obj`.
;;
;; @param counter  the counter to add to
;; @param obj      the object to count
;; @return a new counter; `counter` itself is left alone
to-report add-to-counter [counter obj]
  let index 0
  foreach counter [count-pair ->
    if obj = (cp-object count-pair) [
      report replace-item index counter (cp-increase count-pair)
    ]
    set index index + 1
  ]
  report (lput (new-count-pair obj) counter)
end

;; How often `obj` has been counted.
;;
;; @param counter  the counter to read
;; @param obj      the object to look up
;; @return the count, or -1 when `obj` was never counted
to-report counter-get-count [counter obj]
  foreach counter [count-pair ->
    if obj = (cp-object count-pair) [
      report cp-count count-pair
    ]
  ]
  report -1
end

;; The most frequently counted object, ties broken in order of insertion.
;;
;; @param counter  a non-empty counter
;; @return the object with the highest count
;; @see counter-min-value
to-report counter-max-value [counter]
  report item 0 (reduce [ [x y] -> ifelse-value cp-count x >= cp-count y [x] [y] ] counter)
end

;; The least frequently counted object, ties broken in order of insertion.
;;
;; @param counter  a non-empty counter
;; @return the object with the lowest count
;; @see counter-max-value
to-report counter-min-value [counter]
  report item 0 (reduce [ [x y] -> ifelse-value cp-count x < cp-count y [x] [y] ] counter)
end

;; A count-pair for `obj`, counted once. Count-pairs are the entries of a counter.
;;
;; @param obj  the object to count
;; @return the count-pair `[obj 1]`
;; @internal
to-report new-count-pair [obj]
  report (list obj 1)
end

;; The object of a count-pair.
;;
;; @param pair  a count-pair
;; @return the counted object
;; @internal
to-report cp-object [pair]
  report item 0 pair
end

;; The tally of a count-pair.
;;
;; @param pair  a count-pair
;; @return how often the object has been counted
;; @internal
to-report cp-count [pair]
  report item 1 pair
end

;; A count-pair with its tally raised by one.
;;
;; @param pair  a count-pair
;; @return a new count-pair; `pair` itself is left alone
;; @internal
to-report cp-increase [pair]
  report (list (cp-object pair) (cp-count pair + 1))
end

;; Print every turtle's neighbours as graphviz edges, for exporting the network.
;;
;; @param neighbour-function  a string of NetLogo code reporting an agentset of
;;                            neighbours, run in the context of each turtle
;; @context observer
;; @side-effects prints one `a->b` line per edge to the command centre
;; @example
;; export-to-graphviz-util "link-neighbors"
to export-to-graphviz-util [neighbour-function]
  ask turtles [ ask run-result neighbour-function [print (word [who] of myself "->" who)]]
end




