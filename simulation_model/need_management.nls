;health
to-report SUE-health [ad]
  let base 1
  let belief-modifier 1
  let motive motive-of ad
  let gp location-of ad
  ;agent expects to get food from markets and stores 
  if motive = "get food" [
  report 0.5
  ]
  ;if agent getting treatment at home, decrease health
  if motive = "get treatmet" and gp = my-home [
  ;this should depend on the agent belief
    set belief-modifier 0.5 ;magic number here, add epistemic and social network logic later
    report base * belief-modifier
  ]
  
  if is-believing-to-be-infected? or has-internally-visible-symptoms?
  [
    ifelse is-observing-critical-symptoms? [
      ifelse is-get-healed-to-hospital-descriptor? ad and (is-currently-allocated-a-bed-in-hospital? or any-free-bed-in-hospital?)
      [set base .8]
      [set base 0]
    ] [
      ;if not observing critical symptoms
      ifelse is-get-healed-to-hospital-descriptor? ad and (is-currently-allocated-a-bed-in-hospital? or any-free-bed-in-hospital?)
      [set base .3]
      [ ifelse is-rest-at-home-descriptor? ad
        [ set base 0.3 ]
        [ set base -0.1 ]
      ]
    ]
  ]
  ;;can be updated if agents start to be deprived from sleep, not needed at the moment
  report base
end


;social status
;this could be tied to financial survival
;will decrease once treatment at hospital is working
;implement social status increase for leisure activity
to-report SUE-social-status [ad]
  let gp location-of ad
  let motive motive-of ad 
  ;social status comes from working and shopping at store, attending religious gathering, and sending kids to school
  ifelse is-female? [
    if ([gathering-type] of gp = "store") and (motive = "get food")[
      report 0.4]
  ][
    if ([gathering-type] of gp = my-work ) and (motive = "work")[report 0.4]
  ]
;   if age = "young" [
;       if (gp = my-school ) and (motive = "learn")[
;       report 0.9]
;   ]
  
  ;social status is expected to increase more for women attending religious gatherings
  if [gathering-type] of gp = "church" and motive = "religious gathering" [
    ifelse is-female? [report 0.8] [report 0.4]]
  
  ;in the case of a male agent getting treatment at hospital, the expected social status decreases
  if is-male? and motive = "get treatment at hospital" [report -0.4]
  
  ; print "default social status"
  
  report 0
  
end


;providing (for family)
;the getting treatment part can use some attention + might need more guard conditions as it might break e.g. locations where we are at work but not working for providing
to-report SUE-providing [ad]
  let gp location-of ad
  let motive motive-of ad
  ;female provide by getting food (more like cooking it but we think about this later)
  if is-female? [
  if ([gathering-type] of gp = "store" or [gathering-type] of gp = "market") and (motive = "get food")[
      report 0.2]
  ]
  
   ;religious gathering attending provides
    if [gathering-type] of gp = "church" and motive = "attend religious gathering" [
    ifelse is-female? [report 0.8] [report 0.4]]
  
    ;in case of sickness, getting treatment at home and at hospital reduces the satisfaction of providing
    ;this should also depend on social networks and beliefs
    if motive = "get treatment get at home" or motive = "get treatment get at hospital" [ 
    ;print "i am sick"
    report -0.4 ]
  
  if is-male? [
    ifelse [gathering-type] of gp = "work" and motive = "providing" [report 0.4] [report -0.4]]
  
   ; print "default providing" 
    report 0
end


;autonomy
to-report SUE-autonomy [ad]
  let gp location-of ad
  let motive motive-of ad
  
  ;working increases autonomy
    if is-working-day-for-me? and (slice-of-the-day = "morning" or slice-of-the-day = "afternoon") [
      ifelse motive = "work" [
      ;currently, not working decreases autonomy
      if ( gp = my-work ) [report 0.9]][report -0.3]]
      
  ;so does going to school
;   if age = "young" [
;       ifelse [gathering-type] of gp = "school"
;       [ report  0.2 ]
;       [ report -0.1 ]
;     ]
  
  ;for the funeral rites, a SDB damages autonomy, while a traditional rite increases it (expectedly)
  ifelse (motive = "organize funeral") [
    ;ifelse (funeral-type = "SDB") [report -0.1][
    report 0.5] [report 0.5]
  ;]
  
  ;getting treatment also impacts autonomy
  ;REFACTORING NEEDED, use switch?
  if (motive = "get treatment at home") [
  report 0.2]
  if (motive = "get treatment at hospital") [
  report -0.2]
 
    ; print "default autonomy"
    report 0

end



;group belonging
to-report SUE-group-belonging [ad]
  let gp location-of ad
  let motive motive-of ad
  ;work and religion positively effects group belonging
  if ( motive = "religious gathering") [report 0.8]
  if ( motive = "work" ) [report 0.5]
  
  if (motive = "organize funeral") [
    report 0.5]
  
  if is-female? and motive = "care for the sick" [
    ;this splits caring at home or at an hospital, eg bringing food to sick relatives
    ;refactor needed
    ifelse (gp = "home") [report 0.5][report 0.3]]
  
  if (motive = "visits") [report 0.4]
  
    ;  print "default group belonging"
    report 0
end


;family belonging
to-report SUE-family-belonging [ad]
  let gp location-of ad
  let motive motive-of ad
  
  ;refactor, females get family belonging by getting food and working at home
    if (is-female? and motive = "get food") [report 0.5]
    if (is-female? and gp = "home" and motive = "work") [report 0.5]
  
  ;work and religion positively effects group belonging
  if ( motive = "religious gathering") [report 0.8]
  if (motive = "organize funeral") [
   ; ifelse (funeral-type = "SDB") [report -0.1][
    report 0.4]
  ;]
  
  if is-female? [
   if motive = "get treatment at home" [report -0.2]
    if motive = "get treatment at hospital" [report -0.4]
    
    if motive = "care for the sick" [
      if gp = "home" [report 0.8]
      if gp = "hospital" [report 0.3] ;this can also depend on social network and beliefs
  ]]
  ;visits have a big effect on family belonging, especially if someone is sick(not modeled now)
  if motive = "visits" [report 0.9]
  
    ;  print "default family belonging"
  report 0
end


;physical safety
to-report SUE-physical-safety [ad]
  
  let gp location-of ad
  let motive motive-of ad
  
  ;working in the mine decreases physical safety
  if motive = "work" [
    ifelse [gathering-type] of gp = "workplace-mine" 
    [report -0.1]
    [report 0.1]
  ;add logic for hospital and schools (girls are in danger when going to school)
    if gp = "hospital" and motive = "work" [report -0.2]
   ; if is-girl and motive "school" [report -0.4]
  ]
  if [gathering-type] of gp = "home" [report 0.2]
    ;  print "default phys safety"
  report 0
end


;social-safety
to-report SUE-social-safety [ad]
  let gp location-of ad
  let motive motive-of ad
  
  if is-female?
  [ if ( motive = "get food" and [gathering-type] of gp = "store") ;this is supposed to be market, which are once a week and needs balancing with decay
    [report 0.4]
    if ( motive = "get treatment at hospital") [report -0.2]
  ]
  ;religious gatherings increase social safety, as do visits
  if ( motive = "attend religious gathering" or motive = "visits") [report 0.8]
      ;print "default social safety"
    report 0
end


;************************************************************
;*************** SDE ALL CALCULATIONS ***********************
;************************************************************

;SURVVAL NEEDS

to-report SDE-food [ad]
  let expected-increase SUE-food ad
  let discounted-increase expected-increase * (1 - food-satisfaction-level)
  report discounted-increase
end

to-report SDE-financial-survival [ad]
  let expected-increase SUE-financial-survival ad
  let discounted-increase expected-increase * (1 - financial-survival-satisfaction-level)
  report discounted-increase
end

to-report SDE-sleep [ad]
  let expected-increase SUE-sleep ad
  let discounted-increase expected-increase * (1 - sleep-satisfaction-level)
  report discounted-increase
end

to-report SDE-health [ad]
  let expected-increase SUE-health ad
  let discounted-increase expected-increase * (1 - health-satisfaction-level)
  report discounted-increase
end


; BELONGING NEEDS

to-report SDE-group-belonging [ad]
  let expected-increase SUE-group-belonging ad
  let discounted-increase expected-increase * (1 - group-belonging-satisfaction-level)
  report discounted-increase
end

to-report SDE-family-belonging [ad]
  let expected-increase SUE-family-belonging ad
  let discounted-increase expected-increase * (1 - family-belonging-satisfaction-level)
  report discounted-increase
end

;;; SELF-ESTEEM NEEDS

to-report SDE-autonomy [ad]
  let expected-increase SUE-autonomy ad
  let discounted-increase expected-increase
  if expected-increase > 0 [ set discounted-increase expected-increase * (1 - autonomy-satisfaction-level) ]
  report discounted-increase
end


to-report SDE-social-status [ad]
  let expected-increase SUE-social-status ad
  let discounted-increase expected-increase
  if expected-increase > 0 [ set discounted-increase expected-increase * (1 - social-status-satisfaction-level) ]
  report discounted-increase
end


to-report SDE-providing [ad]
  let expected-increase SUE-providing ad
  let discounted-increase expected-increase
  if expected-increase > 0 [ set discounted-increase expected-increase * (1 - providing-satisfaction-level) ]
  report discounted-increase
end

;; SAFETY NEEDS


to-report SDE-social-safety [ad]
  let expected-increase SUE-social-safety ad
  let discounted-increase expected-increase
  if expected-increase > 0 [ set discounted-increase expected-increase * (1 - social-safety-satisfaction-level) ]
  report discounted-increase
end


to-report SDE-physical-safety [ad]
  let expected-increase SUE-physical-safety ad
  let discounted-increase expected-increase
  if expected-increase > 0 [ set discounted-increase expected-increase * (1 - physical-safety-satisfaction-level) ]
  report discounted-increase
end




;************************************************************
;*************** SDA ALL CALCULATIONS ***********************
;************************************************************


to-report  SDA-food [ad]
  let expected-increase SUA-food ad
  let discounted-increase expected-increase * (1 - food-satisfaction-level)
  report discounted-increase
end


to-report  SDA-group-belonging [ad]
  let expected-increase SUA-group-belonging ad
  let discounted-increase expected-increase * (1 - group-belonging-satisfaction-level)
  report discounted-increase
end

to-report  SDA-family-belonging [ad]
  let expected-increase SUA-family-belonging ad
  let discounted-increase expected-increase * (1 - family-belonging-satisfaction-level)
  report discounted-increase
end





;************************************************************
;*************** SUA ALL CALCULATIONS ***********************
;************************************************************

to-report SUA-food [ad] 
  ;perfect expectations for now
  report SUE-food ad
end


to-report SUA-group-belonging [ad]
    ;perfect expectations for now
  report SUE-group-belonging ad
end


to-report SUA-family-belonging [ad]
    ;perfect expectations for now
  report SUE-family-belonging ad
end




;************************************************************
;*************** global prevalence ***********************
;************************************************************

to-report global-prevalence-of [ad]
  ;*** this procedure should be expanded with new needs as they are added ***
  reset-timer
  let total-satisfaction 0
;  if cultural model is activated then:
 ; calculate the total-satisfaction an agent expects to gain from performing an activity as the weighted sum of all its needs
  set total-satisfaction sum (list
    ;Survival needs
    (SDE-food ad * importance-weight-food) 
    (SDE-financial-survival ad * importance-weight-financial-survival)
    (SDE-sleep ad * importance-weight-sleep) 
    (SDE-health ad * importance-weight-health) 
    ;Belonging needs
    (SDE-group-belonging ad * importance-weight-group-belonging)
    (SDE-family-belonging ad * importance-weight-family-belonging)
    ;Esteem needs
    (SDE-autonomy ad * importance-weight-autonomy) 
    (SDE-social-status ad * importance-weight-social-status) 
    (SDE-providing ad * importance-weight-providing)
    ;Safety needs
    (SDE-physical-safety ad * importance-weight-physical-safety) 
    (SDE-social-safety ad * importance-weight-social-safety)
    )
  
  if log-preferred-activity-decision? [log-file-print (sentence "Global prevalence of:" [gathering-type] of location-of ad " " motive-of ad " " social-distancing-of ad " " total-satisfaction)]
  report total-satisfaction


end



to debug-global-prevalence-of [ad]
  
 if log? [
    debug-print (sentence [gathering-type] of (location-of ad) " " motive-of ad " ") 
      ;Survival needs
    debug-print (word "  Food:" (SDE-food ad * importance-weight-food))
    debug-print (word "  Financial-survival:" (SDE-financial-survival ad * importance-weight-financial-survival))
    debug-print (word "  Sleep:" (SDE-sleep ad * importance-weight-sleep))
    debug-print (word "  Health:" (SDE-health ad * importance-weight-health))
      ;Safety needs
    debug-print (word "  Physical Safety:" (SDE-physical-safety ad * importance-weight-physical-safety))
    debug-print (word "  Social Safety:" (SDE-social-safety ad * importance-weight-social-safety))
      ;Belonging needs
    debug-print (word "  Belonging group:" (SDE-group-belonging ad * importance-weight-group-belonging))
    debug-print (word "  Belonging family:" (SDE-family-belonging ad * importance-weight-family-belonging))
      ;Esteem needs
    debug-print (word "  Autonomy:" (SDE-autonomy ad * importance-weight-autonomy))
    debug-print (word "  Social status:" (SDE-social-status ad * importance-weight-social-status))
    debug-print (word "  Providing:" (SDE-providing ad * importance-weight-providing))
    
    debug-print (word " Global:" global-prevalence-of ad)
  ]
end




to debug-my-preferred-available-activity-descriptor
  
    foreach my-available-activity-descriptors debug-global-prevalence-of
  
end