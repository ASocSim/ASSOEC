;   print amount-of-rations-I-buy-when-going-to-essential-shops
;   print "eating costs"
;   print eating-costs
;   print "exp income"
;   print my-expected-income

  
    if motive = "work"
  [
    print "me working at"
    print my-work
    print [gathering-type] of gp
    print [gathering-type] of my-work
      ;get money from work, except work in the household
      ;print min list (my-expected-income / eating-costs) 1
      ;print "minimum"
       report min list (my-expected-income / eating-costs) 1
      
;     print max (list ((- my-expected-income) / eating-costs) 0)
;     print "maxx"
      ; report max (list ((- my-expected-income) / eating-costs) 0)
     ]
  
  
  
    if motive = "get food" [
;       let money-left-over my-amount-of-capital - eating-costs
;     print my-amount-of-capital
;     print money-left-over
;       ; If we spend all our money, financial-survival will drop to 0
;       if money-left-over < 0 [

;         report (- financial-survival-satisfaction-level)
;       ]
;           print (- min (list (money-left-over / eating-costs) 1))
