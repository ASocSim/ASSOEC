; ;make new setup-person for ebola agent vars

to setup-person [current-home l-sex]
  create-people 1 [
    set sex l-sex
    set time-when-infected "never"

    set has-been-tested-infected? false
;    set my-amount-of-capital my-starting-amount-of-capital
    set current-activity current-home
    set my-home current-home

    set my-target-amount-of-capital my-amount-of-capital
    set has-been-tested-immune? false

    create-gathering-link-to current-home [set features (list "rest" "visit family")]
    set is-moving-outside-for-reaching-current-activity? false


    set is-currently-allocated-a-bed-in-hospital? false

    setup-relation-to-gathering-points    

 ;   set can-I-perform-solo-transportation? random-float 1  <  owning-solo-transportation-probability   ;; IS THIS RELEVANT IN EBOLA?

    set current-person-I-depend-on nobody   ;;MOD FOR CARETAKING
    set color default-color
    set size 0.5
    set infection-state susceptible-infection-status
    set epistemic-infection-status "healthy"
    set last-day-observed-symptoms nobody ;should raise an error if used before being initialized
    set has-done-shopping false
    set stayed-out-queuing-for-bus? false
    set is-activity-successful? true

    set I-know-of-social-distancing? ifelse-value Aware-of-social-distancing-at-start-of-simulation? [true] [false]
    set I-know-of-working-from-home? ifelse-value Aware-of-working-at-home-at-start-of-simulation? [true] [false]
    set what-my-network-did-week-day []
    set what-my-network-did-weekend []
    set did-my-network-socially-distance? false
    
    set #days-I-should-remain-in-self-quarantining 0
    set  events-to-process (list)
  ]
end



to setup-relation-to-gathering-points

  create-gathering-link-to one-of hospitals
  [
    set features (list "get-tested" "get-treatment")
  ]

  create-gathering-link-to one-of markets
  [  set features (list "relaxing")]
  create-gathering-link-to one-of stores
  [ set features (list "relaxing")]
  
  create-gathering-link-to one-of churches
  [ set features (list "belonging")]

  setup-relation-to-gathering-points1
end

to setup-relation-to-gathering-points1

  set my-markets n-of (min list 2 (ceiling (#markets-gp * 0.2))) markets
   create-gathering-links-to my-markets
  [ set features (list "essential shopping" "shopping")]
  
  create-gathering-links-to n-of (min list 4 (ceiling (#stores-gp * 0.4))) stores
  [ set features (list "shopping")] ;"relaxing"

  if is-young? [
    create-gathering-link-to one-of schools [ set features (list "mandatory")]]

  ;;;this is temporary setup to be improved
  
  if is-worker? and is-male? [ create-gathering-link-to one-of workplace-mines [ set features (list "providing" "working")]]
  if is-worker? and is-female? [ create-gathering-link-to one-of workplace-agriculture [ set features (list "working")]
    ]
  setup-worker-relation-to-gathering-point
end

to  setup-worker-relation-to-gathering-point
  if is-worker? [
; if is-male? [
    let hired false
    let target one-of workplace-mines
    
    ask gathering-points with [is-workplace? or is-hospital? or is-school? or is-mine? or is-store? or is-market? or is-church?]
    [
      if not any? hired-workers [ set target self set hired true stop ]
    ]
  
   if not hired [
      let rand random-float 1
      if rand < probability-hospital-personel [
        set target one-of hospitals
      ]
      if rand >= probability-hospital-personel and rand < probability-hospital-personel + probability-school-personel
      [
        set target one-of schools
      ]
      
      if rand >= probability-hospital-personel + probability-school-personel and rand < probability-hospital-personel + probability-school-personel + probability-church-personel
      [
        set target one-of churches
      ]
      
      if rand >= probability-hospital-personel + probability-school-personel + probability-church-personel and
      rand < probability-hospital-personel + probability-school-personel + probability-church-personel + probability-shopkeeper
      [
        set target one-of store
      ]
    ]
    
    set my-work target
    ask target [set hired-workers (turtle-set hired-workers myself)]
  ]
end



 to setup-activities-ebo
   set hospitals (turtle-set)
     set workplace-mines (turtle-set)
     set workplace-agriculture (turtle-set)
   set stores (turtle-set)
   set schools (turtle-set)
   set homes (turtle-set)
   set markets (turtle-set)
  set churches (turtle-set)
 ; set burial-rites (turtle-set)

  
  ;;TO CALIBRATE
  if bunia_proxemics [
  set #hospital-gp 2
  set density-factor-hospitals 1
    set #mines-gp 10
    set density-factor-mines 0.5
    set #agriculture-gp 10
    set density-factor-agriculture 0.1    
  set #stores-gp 5
  set density-factor-store 0.7
  set #schools-gp 2
  set density-factor-schools 0.3
  ;set #homes-gp 200
  ;set density-factor-homes 0.8
  set #markets-gp 3
  set density-factor-markets 0.4
     ;set #burial-rites-gp 5
     ;set density-factor-burial-rites 0.9
   ]
  
  
  
 create-gathering-points #hospital-gp [
    set  hospitals (turtle-set  hospitals self)
    set hired-workers (turtle-set)
    set gathering-type "hospital" set shape "circle" set heading 45 set color lime set size 2 set xcor 6 * max-pxcor / 10 set ycor max-pycor * count gathering-points with [gathering-type = "hospital"] / (#hospital-gp + 1)]
  
  create-gathering-points #mines-gp [
    set workplace-mines (turtle-set workplace-mines self)
    set hired-workers (turtle-set)
    set gathering-type "workplace-mine" set shape "square 2" set color brown  set xcor 7 * max-pxcor / 10 set ycor max-pycor * count gathering-points with [gathering-type = "workplace-mine"] / (#mines-gp + 1)]

   
  create-gathering-points #agriculture-gp [
    set workplace-agriculture (turtle-set workplace-agriculture self)
    set hired-workers (turtle-set)
    set gathering-type "workplace-agriculture" set shape "square 2" set color green  set xcor 8 * max-pxcor / 10 set ycor max-pycor * count gathering-points with [gathering-type = "workplace-agriculture"] / (#agriculture-gp + 1)]  
  

  create-gathering-points #stores-gp [
    set stores (turtle-set stores self)
    set hired-workers (turtle-set)
    set gathering-type "store" set shape "cow" set color yellow set xcor 9 * max-pxcor / 10 set ycor max-pycor * count gathering-points with [gathering-type = "store"] / (#stores-gp + 1)]
  
  
  create-gathering-points #schools-gp [
    set schools (turtle-set schools self)
    set hired-workers (turtle-set)
    set gathering-type "school" set shape "triangle" set color pink set xcor 3 * max-pxcor / 10 set ycor max-pycor * count gathering-points with [gathering-type = "school"] / (#schools-gp + 1)]

  create-gathering-points #markets-gp [
    set markets (turtle-set markets self)
    set hired-workers (turtle-set)
    set gathering-type "market" set shape "target" set color red set xcor 4 * max-pxcor / 10 set ycor max-pycor * count gathering-points with [gathering-type = "market"] / (#markets-gp + 1)]
  
  
  create-gathering-points #churches-gp [
    set churches (turtle-set churches self)
    set hired-workers (turtle-set)
    set gathering-type "church" set shape "pentagon" set color sky set  xcor 5 * max-pxcor / 10 set ycor max-pycor * count gathering-points with [gathering-type = "church"] / (#churches-gp + 1)]

  
  ask gathering-points [set hired-workers (turtle-set)] 
  
  setup-activity-animate-positions
; setup-economy
  
  if migration?
  [
    create-gathering-points 1
    [
      set gathering-type "away"
      set away-gathering-point self
      set shape "airplane"
    ]
  ]
  
  ask gathering-points with [gathering-type = 0] [error (sentence "ill defined " self)]
end


to setup-gathering-point-capacities
  ask gathering-points [
    set capacity disabled-capacity
  ]
  ask markets [
    set capacity count gatherers
  ]
  ask stores [
    set capacity count gatherers
  ]
;ask burial-rites [
 ;   set capacity count gatherers
  ;]
end

to setup-activity-animate-positions
  if animate? [
    let endless-loop 0
    let to-place gathering-points
    let placed turtle-set nobody
    while [any? to-place] [
      let focal one-of to-place
      let p-pxcor random-pxcor
      let p-pycor random-pycor
      ifelse count to-place > 10 [
        let placing up-to-n-of 4 to-place with [gathering-type = [gathering-type] of focal]

        while [any? placed with [abs (p-pxcor - pxcor) <= 2  and abs (p-pycor - pycor) <= 2] or p-pxcor >= (max-pxcor - 1) or p-pxcor <= (min-pxcor + 1) or p-pycor >= (max-pycor - 1) or p-pycor <= (min-pycor + 1)] [
          set endless-loop endless-loop + 1
          if endless-loop > 10000 [error "cannot find a spot!"]
          set p-pxcor random-pxcor
          set p-pycor random-pycor
        ]
        (foreach (up-to-n-of (count placing) (sort (([neighbors] of (patch p-pxcor p-pycor)) with [not member? self [neighbors4] of patch p-pxcor p-pycor]))) (sort placing) [ [ p g ] -> ask g [ move-to p ] ])
        set placed (turtle-set placed placing)
      ] [
        while [any? placed with [abs (p-pxcor - pxcor) <= 1 and abs (p-pycor - pycor) <= 1] or p-pxcor = max-pxcor or p-pxcor = min-pxcor or p-pycor = max-pycor or p-pycor = min-pycor] [
          set p-pxcor random-pxcor
          set p-pycor random-pycor
        ]
        ask focal [
          setxy p-pxcor p-pycor
        ]
        set placed (turtle-set placed focal)
      ]
      set to-place to-place with [not member? self placed]
      
    ]
    ;      ask gathering-points [
    ;        let possible-xcor random-pxcor
    ;        let possible-ycor random-pycor
    ;        while [any? gathering-points-on patch possible-xcor possible-ycor] [
    ;          set possible-xcor random-pxcor
    ;          set possible-ycor random-pycor
    ;        ]
    ;        setxy possible-xcor possible-ycor
    ;      ]
  ]
end



