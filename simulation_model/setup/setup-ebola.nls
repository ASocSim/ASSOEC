;; @file setup/setup-ebola.nls
;; @brief Builds the world: places, households, people, jobs and social networks.
;;
;; Run once from the interface Setup button. The order matters and is roughly:
;; create the gathering points, fill them with households and people, wire people
;; to the places they may use, hire them, size the places, give people their
;; values and needs, and finally build the friendship network and the metrics
;; tables.
;;
;; Much of the COVID setup survives here commented out - infecting a first
;; generation, phasing out measures, buses and shared cars - and is left in place
;; as the reference for what the Ebola equivalents will need to do.
;;
;; @see gathering_points.nls
;; @see people_management.nls
;; @see country_specific_features/cultural_model.nls
;; @see docs/WIP_ISSUES.md

__includes ["scenarios.nls" "setup/household-configuration.nls"]


globals[]

;; Build a whole world from the current interface settings.
;;
;; Clears everything, resets the clock to Monday morning of day 0, then runs the
;; setup chain in dependency order. The metrics tables are built last, once the
;; population they count exists.
;;
;; @context observer
;; @side-effects clears the world and creates every turtle and link in it
;; @note Nobody is infected at setup: the COVID block that seeded the first
;; infections is commented out, so a run stays disease-free until something else
;; introduces a case.
to setup-ebola
  clear-all
  reset-ticks
  
  if clear-log-on-setup? [clear-logfile]
  if log? [print "debug mode active; this dramatically slows down computation speed"]
;   check-parameters
  set-default-shape people "person"
  if log? or static-seed?[  random-seed #random-seed ]
  set slice-of-the-day "morning"
  set day-of-the-week "monday"
  set current-day 0
  set #dead-people 0
  
  set was-social-distancing-enforced? false
  set when-has-2%-infected-threshold-first-been-met? "never"
  set when-has-5%-infected-threshold-first-been-met? "never"
  set start-tick-of-global-quarantine "never"

  

  
  setup-gathering-points-as-turtle-sets
  create-all-households
  layout-gathering-points
  setup-relation-to-gathering-points
  setup-worker-relation-to-gathering-point


  setup-gathering-point-capacities
  setup-person-values-and-needs
  setup-social-networks
  
;   if with-infected? [
;     set first-infected-people n-of (min list 3 count people) people
;     ask first-infected-people [contaminate nobody ("setup")]
;     set #first-infected-people count first-infected-people
;   ]
;   setup-phasing-out

  update-display

  ask gathering-links
   [hide-link]

;   set is-lockdown-active? false
;   set list-of-buses (list)
;   set list-of-shared-cars (list)
  
;   if log-setup? [foreach sort gathering-points [[x]-> log-file-print [(word "description_gathering_poing(" who "," gathering-type ")")] of x]]

;   setup-agent-inspector
 
;   ;;must be in the end
   setup-global-metrics
end


;; Create the tables and counters the metrics reporters accumulate into.
;;
;; Sets up the per-sex contact and infection tables, records the starting
;; population by sex, and clears the per-tick series.
;;
;; @context observer
;; @side-effects replaces the global metrics tables and lists
;; @see reset-metrics
to setup-global-metrics
  
  set number-of-people-per-sex-having-ever-reached-severe-table table:make
  table:put number-of-people-per-sex-having-ever-reached-severe-table female-sex 0
  table:put number-of-people-per-sex-having-ever-reached-severe-table male-sex 0
;  table:put number-of-people-per-sex-having-ever-reached-severe-table worker-age 0
 ; table:put number-of-people-per-sex-having-ever-reached-severe-table retired-age 0
  
  set #females-at-start count female-agentset
  set #males-at-start count male-agentset
;  set #boys-at-start count boys
 ; set #girls-at-start count girls  
  
  set sex-group-to-sex-group-#contacts-table table:make
  set sex-group-to-sex-group-#infections-last-tick-table table:make
  set sex-group-to-sex-group-cumulated-#contacts-table table:make
  set #infected-people-per-ticks (list)
  set  #hospitalized-per-tick (list)
  reset-metrics
  
end

;; Create every place in the world and collect each kind into its own turtle-set.
;;
;; One pass per kind of place: create the configured number of them, give each its
;; `gathering-type`, its vacancy count, and the shape, colour and position it will
;; have on the view. Places of the same kind are spread vertically so they can be
;; told apart. The abroad placeholder is created only when migration is enabled.
;;
;; @context observer
;; @side-effects creates gathering points and fills the `hospitals`, `schools`,
;; `stores`, `markets`, `churches`, `cemeteries`, `workplace-mines` and
;; `workplace-agriculture` globals
;; @side-effects raises an error if any place ends up without a `gathering-type`
;; @note Homes are not created here - `create-all-households` makes them.
;; @see layout-gathering-points
 to setup-gathering-points-as-turtle-sets
   set hospitals (turtle-set)
   set workplace-mines (turtle-set)
   set workplace-agriculture (turtle-set)
   set stores (turtle-set)
   set schools (turtle-set)
   set homes (turtle-set)
   set markets (turtle-set)
   set churches (turtle-set)
   set cemeteries (turtle-set)
  
 create-gathering-points #hospital-gp 
 [
    set vacancies 5
    set hospitals (turtle-set  hospitals self)
    set hired-workers (turtle-set)
    
    set gathering-type "hospital" set shape "circle" set color lime set size 2
  ]
  
  create-gathering-points #mines-gp 
  [
    set vacancies 5
    set workplace-mines (turtle-set workplace-mines self)
    set hired-workers (turtle-set)

    set gathering-type "workplace-mine" set shape "square 2" set color brown
  ]

   
  create-gathering-points #agriculture-gp 
  [
    set vacancies 5
    set workplace-agriculture (turtle-set workplace-agriculture self)
    set hired-workers (turtle-set)
    set gathering-type "workplace-agriculture" set shape "square 2" set color green
  ]
  

  create-gathering-points #stores-gp 
  [
    set vacancies 1
    set stores (turtle-set stores self)
    set hired-workers (turtle-set)
    set gathering-type "store" set shape "cow" set color yellow
  ]
  
  
  create-gathering-points #schools-gp 
  [
    set vacancies 5
    set schools (turtle-set schools self)
    set hired-workers (turtle-set)
    set gathering-type "school" set shape "triangle" set color pink
  ]

  create-gathering-points #markets-gp [
    set vacancies 5
    set markets (turtle-set markets self)
    set hired-workers (turtle-set)
    set gathering-type "market" set shape "target" set color red]
  
  create-gathering-points #cemeteries-gp
  [
    set vacancies 3
    set cemeteries (turtle-set cemeteries self)
    set hired-workers (turtle-set)
    set gathering-type "cemetery" set shape "circle" set color gray
  ]

  create-gathering-points #churches-gp [
    set vacancies 3
    set churches (turtle-set churches self)
    set hired-workers (turtle-set)
    set gathering-type "church" set shape "pentagon" set color sky]

  
  ask gathering-points [set hired-workers (turtle-set)]

; setup-economy

  if migration?
  [
    create-gathering-points 1
    [
      set gathering-type "away"
      set away-gathering-point self
      set shape "airplane"
    ]
  ]

  ask gathering-points with [gathering-type = 0] [error (sentence "ill defined " self)]
end


;; Create every household, and stock the homes with food.
;;
;; The configured household ratios decide how many are family homes and how many
;; are homes of displaced people; anything left over after the family homes are
;; taken becomes a displaced home. Each home then starts with between one and two
;; full buying cycles of rations per resident.
;;
;; @context observer
;; @side-effects creates home gathering points and the people who live in them
;; @note The adult-only household type is implemented but commented out of the
;; loop, so no adult homes are created.
to create-all-households
  load-population-profile-based-on-current-preset-profile

  let #adults-homes floor (#households * ratio-adults-homes)
  let #family-homes floor (#households * ratio-family-homes)
  let #displaced-homes #households - (#adults-homes + #family-homes) ;+ #retired-couple-homes + #multigenerational-homes

;  repeat #adults-homes [create-household "adult"]
  repeat #family-homes [create-household "family"]
  repeat #displaced-homes [create-household "displaced"]

  ask homes
  [
    set available-food-rations count gatherers * (random days-of-rations-bought + days-of-rations-bought)
  ]
end

;; Create one household of type `t` and the people in it.
;;
;; A family home gets one to three men and one to three women. A displaced home
;; gets three to four men and no women. Any other type raises an error rather than
;; producing an empty house.
;;
;; @param t                      household type, "family" or "displaced"
;; @param #created-households    how many households exist already, used to place
;;                               this one on the view
;; @param #households-to-create  the total being created, used for the same
;; @context observer
;; @side-effects creates one home gathering point and its residents
;; @todo Household composition is a guess: how many people a family home should
;; hold needs a source.
to create-household [t]
  let current-home nobody
  create-gathering-points 1
  [
    ;print self
    set current-home self
    set homes (turtle-set homes self)
    set gathering-type "home"
    setup-GUI-household
  ]
  
;;need more info on household composition, how many in a family home?

  if t = "family"
  [
    let men random 3 + 1
    let women random 3 + 1

    setup-home current-home men women

    stop
  ]

   if t = "displaced"
  [
    let men random 2 + 3
    setup-home current-home men 0
    stop
  ]

  error (sentence "not implemented" t)
end

;; Create `men` men and `women` women living at `current-home`.
;;
;; @param current-home  the home they live in
;; @param men           how many men to create
;; @param women         how many women to create
;; @context observer
;; @side-effects creates people
to setup-home [current-home men women]
  if men > 0
  [
    repeat men [setup-person current-home male-sex] 
  ]

  if women > 0
  [
    repeat women [setup-person current-home female-sex]
  ]
end

;; Give this home its appearance on the view.
;;
;; Where it ends up is not decided here: `layout-gathering-points` arranges the
;; homes over the residential quarter once they all exist.
;;
;; @context gathering-point
;; @side-effects sets `shape` and `color`
;; @see layout-gathering-points
to setup-GUI-household
  set shape "house"
  set color green
end
; ;make new setup-person for ebola agent vars

;; Create one person living at `current-home`.
;;
;; Sets the starting state a person needs before the first tick: susceptible,
;; never infected, believing themselves healthy, at home, with 100 units of
;; capital. Women are given their home as their workplace, which the hiring pass
;; may later replace; men are left unemployed for that pass to fill.
;;
;; The link to the home carries the reasons a person has for being there - rest,
;; visits, work, care, treatment and both kinds of belonging.
;;
;; @param current-home  the home this person lives in
;; @param l-sex         `female-sex` or `male-sex`
;; @context observer
;; @side-effects creates one person and their gathering link to the home
;; @note `age` is never set here, or anywhere else, so every age predicate in the
;; model is false for everyone.
to setup-person [current-home l-sex]
  
  create-people 1 
  [
    set sex l-sex
    set time-when-infected "never"

    set has-been-tested-infected? false
    set my-amount-of-capital 100 ;my-starting-amount-of-capital
    set current-activity current-home
    set my-home current-home
    set schedule (list "hello" "its a-meeee, maaaaario")
    
    if (sex = "female" )
    [
      set my-work current-home
    ]

    set my-target-amount-of-capital my-amount-of-capital
    set has-been-tested-immune? false

    create-gathering-link-to current-home [set features (list "rest" "visits" "work" "care for the sick" "get treatment" "family belonging" "group belonging")]
    
    set is-moving-outside-for-reaching-current-activity? false

    set is-currently-allocated-a-bed-in-hospital? false


 ;   set can-I-perform-solo-transportation? random-float 1  <  owning-solo-transportation-probability   ;; IS THIS RELEVANT IN EBOLA?

    set current-person-I-depend-on nobody   ;;MOD FOR CARETAKING
    set color default-color
    set size 0.5
    set infection-state susceptible-infection-status
    set epistemic-infection-status "healthy"
    set last-day-observed-symptoms nobody ;should raise an error if used before being initialized
    set stayed-out-queuing-for-bus? false
    set is-activity-successful? true

   ; set I-know-of-social-distancing? ifelse-value Aware-of-social-distancing-at-start-of-simulation? [true] [false]
   ; set I-know-of-working-from-home? ifelse-value Aware-of-working-at-home-at-start-of-simulation? [true] [false]
    set what-my-network-did-week-day []
    set what-my-network-did-weekend []
    set did-my-network-socially-distance? false
    
    set #days-I-should-remain-in-self-quarantining 0
    set  events-to-process (list)
  ]
end


;; Attach every person to the places they may use, and record why they would go.
;;
;; Everyone gets one hospital, and one of each of market, store, church, school,
;; mine, farm and cemetery. The choice of place is random; what differs by sex is
;; the list of reasons on the link, which is what makes men and women value the
;; same place differently later.
;;
;; @context observer
;; @side-effects creates gathering links from every person
;; @note The two branches differ only for markets and stores; the remaining five
;; place types carry identical feature lists for both sexes.
to setup-relation-to-gathering-points

  ask people
  [
  
  ;;both genders go to hospitals for the same reasons
  create-gathering-link-to one-of hospitals
  [
    set features (list "get treatment" "care for the sick" "work")
  ]

  ;;men go to markets, stores, churches, schools, mines, agriculture and cemeteries for different reasons than women
  if is-male?
  [
    create-gathering-link-to one-of markets
    [
        set features (list "get food" "work" "social status")
    ]

    create-gathering-link-to one-of stores
    [ 
      set features (list "get food" "work" "social status" "providing" )
    ]

    create-gathering-link-to one-of churches
    [ 
      set features (list "group belonging" "family belonging" "work" "social status" "physical safety")
    ]

    create-gathering-link-to one-of schools
    [ 
      set features (list "group belonging" "work" "social status" "autonomy")
    ]

    create-gathering-link-to one-of workplace-mines
    [ 
      set features (list "autonomy" "work" "social status" "group belonging")
    ]

    create-gathering-link-to one-of workplace-agriculture
    [ 
      set features (list "autonomy" "work" "social status" "group belonging")
    ]

    create-gathering-link-to one-of cemeteries
    [ 
      set features (list "group belonging" "family belonging" "work" "social status" "autonomy")
    ]
  ]

  if is-female? 
  [
    create-gathering-link-to one-of markets
    [
      set features (list "leisure" "social status" "providing" "get food" "work" "family belonging")
    ]

    create-gathering-link-to one-of stores
    [
      set features (list "leisure" "social status" "providing" "get food" "work" "family belonging")
    ]

    create-gathering-link-to one-of churches
    [ 
      set features (list "group belonging" "family belonging" "work" "social status" "physical safety")
    ]

    create-gathering-link-to one-of schools
    [ 
      set features (list "group belonging" "work" "social status" "autonomy")
    ]

    create-gathering-link-to one-of workplace-mines
    [ 
      set features (list "autonomy" "work" "social status" "group belonging")
    ]

    create-gathering-link-to one-of workplace-agriculture
    [ 
      set features (list "autonomy" "work" "social status" "group belonging")
    ]

    create-gathering-link-to one-of cemeteries
    [ 
      set features (list "group belonging" "family belonging" "work" "social status" "autonomy")
    ]
  ]
 ]

end

;; Fill each workplace's vacancies, then record who ended up working where.
;;
;; Hospitals and markets hire women who have no job other than their own home;
;; stores, churches, cemeteries, schools and farms hire men, who start with no
;; workplace at all. Every man still unemployed afterwards is sent to a mine, so
;; the mines absorb whatever is left. Each place then rebuilds `hired-workers`
;; from the people who name it as their workplace.
;;
;; @context observer
;; @side-effects sets `my-work` on people and `hired-workers` on places
;; @todo Vacancies are hardcoded per place type at creation, and there is no
;; filter for working age.
to  setup-worker-relation-to-gathering-point
  
  ;;TODO add filter to only people of working age

  ask hospitals
  [ 
    ;print "I am a hospital and I am hiring"
    let hiring-hospital self

    ;;TODO declare vacancies where it makes sense, this is just a hack for now
    while [vacancies > 0]
    [
      let potential-workers people with [my-work = my-home and is-female?]
      if (count potential-workers = 0) [stop]
      let potential-worker one-of potential-workers
      ask potential-worker [set my-work hiring-hospital]

     ;set hired-workers fput potential-worker hired-workers
     set vacancies vacancies - 1
    ]
  ]

  ;register workers with the hospitals
  ask hospitals
  [
    let hiring-hospital self
    set hired-workers (turtle-set people with [my-work = hiring-hospital])
    
  ]

  ask markets
  [ 
    ;;TODO declare vacancies where it makes sense, this is just a hack for now
    while [vacancies > 0]
    [
      let potential-workers people with [my-work = my-home and is-female?]
      if (count potential-workers = 0) [stop]
      let potential-worker one-of potential-workers
      let hiring-market self
      ask potential-worker [set my-work hiring-market]

     ;set hired-workers fput potential-worker hired-workers
     set vacancies vacancies - 1
    ]
  ]

  ask markets
  [
    let hiring-market self
    set hired-workers (turtle-set people with [my-work = hiring-market])
  ]

  ask stores
  [ 
    ;;TODO declare vacancies where it makes sense, this is just a hack for now
    while [vacancies > 0]
    [
      let potential-workers people with [my-work = 0 and is-male?]
      if (count potential-workers = 0) [stop]
      let potential-worker one-of potential-workers
      let hiring-store self
      ask potential-worker [set my-work hiring-store]
      ;set hired-workers fput potential-worker hired-workers
      set vacancies vacancies - 1
    ]
  ]

  ask stores
  [
    let hiring-store self
    set hired-workers (turtle-set people with [my-work = hiring-store])
  ]
  
  ask churches
  [ 
    ;;TODO declare vacancies where it makes sense, this is just a hack for now
    while [vacancies > 0]

    [
      let potential-workers people with [my-work = 0 and is-male?]
      if (count potential-workers = 0) [stop]
      let potential-worker one-of potential-workers
      let hiring-church self
      ask potential-worker [set my-work hiring-church]
      ;set hired-workers fput potential-worker hired-workers
      set vacancies vacancies - 1
    ]
  ]
  
  ask churches
  [
    let hiring-church self
    set hired-workers (turtle-set people with [my-work = hiring-church])
  ]
  ask cemeteries
  [ 
    ;;TODO declare vacancies where it makes sense, this is just a hack for now
    while [vacancies > 0]

    [
      let potential-workers people with [my-work = 0 and is-male?]
      if (count potential-workers = 0) [stop]
      let potential-worker one-of potential-workers
      let hiring-cemetery self
      ask potential-worker [set my-work hiring-cemetery]
      ;set hired-workers fput potential-worker hired-workers
      set vacancies vacancies - 1
    ]
  ]

  ask cemeteries
  [
    let hiring-cemetery self
    set hired-workers (turtle-set people with [my-work = hiring-cemetery])
  ]

  ask schools
  [ 
    ;;TODO declare vacancies where it makes sense, this is just a hack for now
    while [vacancies > 0]
    [
      let potential-workers people with [my-work = 0 and is-male?]
      if (count potential-workers = 0) [stop]
      let potential-worker one-of potential-workers
      let hiring-school self
      ask potential-worker [set my-work hiring-school]
      ;set hired-workers fput potential-worker hired-workers
      set vacancies vacancies - 1
    ]
  ]

  ask schools
  [
    let hiring-school self
    set hired-workers (turtle-set people with [my-work = hiring-school])
  ]   
  
  ask workplace-agriculture
  [ 
    ;;TODO declare vacancies where it makes sense, this is just a hack for now
    while [vacancies > 0]
    [
      let potential-workers people with [my-work = 0 ] ;and is-female?
      ; print "I am unemployed, can I work in agriculture?"
      if (count potential-workers = 0) [stop]
      let potential-worker one-of potential-workers
      let hiring-agriculture self
      ask potential-worker [set my-work hiring-agriculture]
      ;set hired-workers fput potential-worker hired-workers
      set vacancies vacancies - 1
    ]
  ]
  
  ask workplace-agriculture
  [
    let hiring-agriculture self
    set hired-workers (turtle-set people with [my-work = hiring-agriculture])
  ]


  ask people with [my-work = 0 ];and is-male?
  [
    ;print "I am unemployed, can I work in mine?"
    let mine one-of workplace-mines
    set my-work mine
  ]

  ask workplace-mines
  [
    let hiring-mine self
    set hired-workers (turtle-set people with [my-work = hiring-mine])
  ]
  
end

;; Decide how many people each place can hold at once.
;;
;; Everywhere is uncapped by default. Markets, stores and churches are then capped
;; at the size of their own attached population, which is the cap
;; `perform-people-activities` enforces.
;;
;; @context observer
;; @side-effects sets `capacity` on every gathering point
;; @see disabled-capacity
to setup-gathering-point-capacities
  ask gathering-points [
    set capacity disabled-capacity
  ]
  ask markets [
    set capacity count gatherers
  ]
  ask stores [
    set capacity count gatherers
  ]
  
  ask churches [
    set capacity count gatherers
  ]
;ask burial-rites [
 ;   set capacity count gatherers
  ;]
end

;; Scatter the gathering points across the view without overlapping them.
;;
;; Only runs when animation is on. Places are positioned in batches: while many
;; remain, up to four of the same kind are dropped together onto the neighbours of
;; a free patch, so places of a kind cluster; once few remain they are placed one
;; at a time. Candidate patches are rejected if they are too close to something
;; already placed or against the world edge.
;;
;; @context observer
;; @side-effects moves every gathering point
;; @side-effects raises "cannot find a spot!" after 10000 failed attempts, which
;; is what happens when there are more places than the world can separate
to setup-activity-animate-positions
  if animate? [
    let endless-loop 0
    let to-place gathering-points
    let placed turtle-set nobody
    while [any? to-place] [
      let focal one-of to-place
      let p-pxcor random-pxcor
      let p-pycor random-pycor
      ifelse count to-place > 10 [
        let placing up-to-n-of 4 to-place with [gathering-type = [gathering-type] of focal]

        while [any? placed with [abs (p-pxcor - pxcor) <= 2  and abs (p-pycor - pycor) <= 2] or p-pxcor >= (max-pxcor - 1) or p-pxcor <= (min-pxcor + 1) or p-pycor >= (max-pycor - 1) or p-pycor <= (min-pycor + 1)] [
          set endless-loop endless-loop + 1
          if endless-loop > 10000 [error "cannot find a spot!"]
          set p-pxcor random-pxcor
          set p-pycor random-pycor
        ]
        (foreach (up-to-n-of (count placing) (sort (([neighbors] of (patch p-pxcor p-pycor)) with [not member? self [neighbors4] of patch p-pxcor p-pycor]))) (sort placing) [ [ p g ] -> ask g [ move-to p ] ])
        set placed (turtle-set placed placing)
      ] [
        while [any? placed with [abs (p-pxcor - pxcor) <= 1 and abs (p-pycor - pycor) <= 1] or p-pxcor = max-pxcor or p-pxcor = min-pxcor or p-pycor = max-pycor or p-pycor = min-pycor] [
          set p-pxcor random-pxcor
          set p-pycor random-pycor
        ]
        ask focal [
          setxy p-pxcor p-pycor
        ]
        set placed (turtle-set placed focal)
      ]
      set to-place to-place with [not member? self placed]
      
    ]
  ]
end



