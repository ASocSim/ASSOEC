;; @file gathering_points.nls
;; @brief Places people go to, and everything the model asks about a place.
;;
;; A gathering point is a home, hospital, school, mine, farm, store, market,
;; church or cemetery. People are attached to the places they may use by
;; `gathering-links`, and the link carries the list of reasons that person has for
;; going there. Where a person is right now is held on the person, in
;; `current-activity`, so "who is here" is a query over the links.
;;
;; The file is mostly small predicates over `gathering-type`, plus the occupancy
;; and capacity reporters used by `perform-people-activities`.
;;
;; @see gathering_points/gathering_types.nls
;; @see activity_model.nls
;; @see docs/WIP_ISSUES.md

__includes ["hospitals.nls" "gathering_points/gathering_types.nls"]
globals [
   hospitals                   ;;< every hospital, as a turtle-set fixed at setup
   schools                     ;;< every school, as a turtle-set fixed at setup
   homes                       ;;< every home, one per household, as a turtle-set fixed at setup
   markets                     ;;< every market, as a turtle-set fixed at setup
   workplace-mines             ;;< every mine, as a turtle-set fixed at setup
   workplace-agriculture       ;;< every agricultural workplace, as a turtle-set fixed at setup
   workplace-homes             ;;< declared but never assigned; homes double as workplaces instead
   stores                      ;;< every store, as a turtle-set fixed at setup
   churches                    ;;< every church, as a turtle-set fixed at setup
   cemeteries                  ;;< every cemetery, as a turtle-set fixed at setup
   leisure                     ;;< declared but never assigned; the Ebola setup creates no leisure venues
]

;; A place people can go to: a home, hospital, school, mine, farm, store, market,
;; church or cemetery. The kind is held as a string in `gathering-type`.
breed [gathering-points gathering-point]

gathering-points-own [
  gathering-type              ;;< which kind of place this is, as a string; see gathering_points/gathering_types.nls
  available-food-rations      ;;< rations of food held here, in person-days; mostly relevant for homes

  amount-of-capital           ;;< money the place holds, in currency units
  
  hired-workers               ;;< turtle-set of the people employed here, rebuilt by `setup-worker-relation-to-gathering-point`
  stock-of-goods              ;;< goods available to sell; part of the dormant COVID economy
  
  vacancies                   ;;< jobs still unfilled, counted down during setup hiring
  cached-number-of-participants ;;< memoised result of `expected-number-of-other-participants`, 0 until first computed
  capacity                    ;;< how many people may be here at once, or `disabled-capacity` for no limit
]

;; A person's attachment to a place they may use, carrying the reasons they have
;; for going there.
;;
;; Directed from the person to the gathering point, so a place reads its people
;; with `in-gathering-link-neighbors` and a person reads their places with
;; `gathering-link-neighbors`.
directed-link-breed [gathering-links gathering-link]

gathering-links-own [
  features                    ;;< the reasons this person has for coming to this place, as a list of motive strings
]

;; The share of this place's staff who are here and working right now.
;;
;; @context gathering-point
;; @return a number in [0, 1]
;; @note Two current caveats: it divides by zero where nobody is hired, and the
;; motive it tests for is `work-motive` ("contractual obligation") while
;; `select-activity` records the motive as "work", so the numerator stays 0.
to-report ratio-personnel-here
  report count hired-workers with [current-activity = myself and current-motivation = work-motive] / count hired-workers
end

;keep enough cash to pay people for 2 ticks
;; How much cash this place should keep on hand: two ticks of wages for its staff.
;;
;; @context gathering-point
;; @return an amount of capital
;; @unit currency units
to-report max-amount-of-capital-to-retain
  report count hired-workers * workers-wages * 2
end

;; Work in progress.
;;
;; work in progress
;;
;; @context work in progress
;; @return work in progress
;; @todo Reads person variables from the gathering-points file; the agent context
;; it is meant for is undecided. See docs/WIP_ISSUES.md#is-away--and-is-at-work-.
to-report is-away?
  report current-activity = away-gathering-point
end


;; Work in progress.
;;
;; work in progress
;;
;; @context work in progress
;; @return work in progress
;; @todo Compares a `gathering-type` string against agentset reporters, so no
;; branch can match and every call falls through to the error. Live in the
;; contagion path. See docs/WIP_ISSUES.md#proximity-factor.
to-report proximity-factor
  
  if gathering-type = hospital-gathering-type [report density-factor-hospitals]
  if gathering-type = school-gathering-type[report density-factor-schools]
  if gathering-type = markets-gathering-type[report density-factor-markets]
  if gathering-type = workplace-agriculture-gathering-type [report density-factor-agriculture]
  if gathering-type = workplace-mine-gathering-type[report density-factor-mines]
  if gathering-type = stores-gathering-type[report density-factor-store]
  if gathering-type = home-gathering-type[report density-factor-homes]
  if gathering-type = churches-gathering-type [report density-factor-churches]
  if gathering-type = cemeteries-gathering-type [report density-factor-cemeteries]
  if gathering-type = leisure-gathering-type [report density-factor-leisure]
  
  error (word gathering-type " not defined")
end

; ToDo: Update this!
