

undirected-link-breed [my-kin-links my-kin-link]

undirected-link-breed [my-friends-links my-friends-link]

directed-link-breed [my-trustees-links my-trustee-link]

my-trustees-links-own [trust-value]


breed [radios radio]
radios-own [
  broadcast-hospital
  broadcast-medicine
  broadcast-ebola
  broadcast-SDB
 ]

to setup-radios
  create-radios n-radios

ask radios[

set xcor random 69
set ycor 0

  ifelse government-message-radios? [
  set broadcast-hospital -1
  set broadcast-medicine -1
  set broadcast-ebola -1
  set broadcast-SDB 1
][
     set broadcast-hospital random-float 2 - 1
     set broadcast-medicine random-float 2 - 1
     set broadcast-ebola random-float 2 - 1
     set broadcast-SDB random-float 2 - 1
  ]
]
end


to setup-social-network-ebola
  setup-kin-network
  setup-friends-networks
  ;colleagues calculated on demand via gps, not a fixed social network per se

  ;INFORMATION MILL SETUP
  if information-mill?[
  setup-baseline-trust-network
  setup-roles-trust ;; (this updates initial trust in roles)
  ;setup-person-to-person-trust
  ]
end


;;KIN

;displaced people will not have kin networks as extensive as non-displaced people
to setup-kin-network
ask people [
  let me self
  let cohabitants other [gatherers] of my-home
  ask cohabitants [
    if not my-kin-link-neighbor? me 
    [create-my-kin-link-with me
    ]
  ]
  if not displaced?
  [
    let #kin-houses 5
    repeat #kin-houses [
      let kin other [gatherers] of one-of other homes
      ask kin
      [
        if not my-kin-link-neighbor? me 
        [
          create-my-kin-link-with me
        ]
      ]
    ]
  ]
]
end


;;FRIENDS

;; Everyone this person could still befriend.
;;
;; Anyone in the world who is not already a friend, and not the person themselves.
;; The commented-out body above restricts candidates to people met at church or
;; school, which is the intended version once those places are populated.
;;
;; @context person
;; @return agentset of people not yet linked by `my-friends-links`
to-report possible-friends
 ; let agents-to-befriend reduce [ [x y] -> (turtle-set x y) ] ([gatherers] of (turtle-set my-church my-school))
  ;report other agents-to-befriend with [not my-friends-link-neighbor? myself ] ;and age = [age] of myself]
  report other people with [not my-friends-link-neighbor? myself ]
end

;; Give every person up to three friends drawn at random from the whole population.
;; @context observer
to setup-friends-networks
  
  ;  ask workers [  create-workplace-colleague-links-to other workers with [my-workplace = [my-workplace] of myself]]
  ask people [
    ;everyone has the same n of friends
    ; Its up to n so this does not throw an error if there are not enough agents to become friends with
    create-my-friends-links-with up-to-n-of 3 possible-friends
  ]
  
end


;;COLLEAGUES (reporter only)

;; The other people hired by this person's workplace.
;;
;; @context person
;; @return agentset of people, excluding self; empty for anyone who is not a worker (nobody)
to-report my-colleagues
  ;report other [hired-workers] of my-work
  ;report workplace-colleague-link-neighbors
  let my-wp my-workplace
  if my-wp != nobody [
     report other [gatherers with [my-workplace = my-wp]] of my-wp
   ]
   report (turtle-set nobody)
end


;;TRUSTEES
;;people
to-report possible-trustees
  report up-to-n-of 1 other people with [not my-trustee-link-neighbor? myself]
  ;up-to-n-of 10 magic number to reduce comp time when building
end

;;radios that could be trusted, returns agentset
to-report possible-radio-trustees
  report radios with [not my-trustee-link-neighbor? myself ]
end



to setup-baseline-trust-network
;establish trust towards PRIESTS and immediately set it to +1

ask people with [priest? = false][
  let me self
    ask my-priest(my-church) [
     if not my-trustee-link-neighbor? me [
       create-my-trustee-link-to me
       ]
    ask my-out-my-trustees-links [
      set trust-value 1
      set color violet
    ]
  ]
]

;REMEMBER PRIESTS ARE PEOPLE TOO
;firstly we create a trust link between all remaining agents
ask people [
  let me self
    ask possible-trustees [
     if not my-trustee-link-neighbor? me [
       create-my-trustee-link-to me]
       ask my-out-my-trustees-links [
      set trust-value 0
      set color grey
    ]
    ]
]

;create trust links from all agents to all radio (channels)
ask people [
  let me self
  ask possible-radio-trustees [
    if not my-trustee-link-neighbor? me [
      create-my-trustee-link-from me
    ]
  ]
]


end


;then we make roles for priests, hcw, radios and government

to setup-roles-trust
;priests already established 
;;establish mistrust to HCW
ask healthcare-workers[
  let hcw self
    ask in-my-trustee-link-neighbors[
    ask out-my-trustee-link-to hcw [
    set trust-value -1
    set color orange
    ]
  ]
]

;RADIO trust set
;each agent trusts one of the radios and mistrusts others?

ask radios [
  let radio-channel self
  ask in-my-trustee-link-neighbors [
    ask out-my-trustee-link-to radio-channel [
    set color violet
    set trust-value -1
    ]
    ask one-of in-my-trustee-link-neighbors [
    ask out-my-trustee-link-to radio-channel [
      set color green
      set trust-value 1
    ]
  ]
]
]
;;establish mistrust to GOVERNMENT

end



to setup-person-to-person-trust
;now we select links to the kin to increase trust towards
;individual agent gives trust from kin
ask people [
  let me self
  ask my-kin-link-neighbors [
    if (in-my-trustee-link-from me != nobody) [
    ask in-my-trustee-link-from me [
      set trust-value 1
      set color blue
      ]
    ]
  ]
]

;and a few strangers to actively mistrust
ask people [
  ask up-to-n-of 5 my-out-my-trustees-links with [trust-value = 0][
      set trust-value -1
      set color red
    ]

]

end





;;UNUSED functions, might make use of later tho

to establish-trust [new-trustee]
 set trust-value 1
  show (sentence "established my trust in " new-trustee)

end

to revoke-trust [no-longer-trusted]
 ; ask out-my-trustee-link-to no-longer-trusted [ die ]
 set trust-value -1
  show (sentence "removed my trust in " no-longer-trusted)
end


