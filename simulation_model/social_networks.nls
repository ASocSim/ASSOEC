

undirected-link-breed [my-kin-links my-kin-link]

undirected-link-breed [my-friends-links my-friends-link]

directed-link-breed [my-trustees-links my-trustee-link]

to setup-social-network-ebola
  setup-kin-network
  setup-friends-networks
  ;colleagues calculated via gps
  setup-trust-network
end


;;KIN

;displaced people will not have kin networks as extensive as non-displaced people
to setup-kin-network
ask people [
  let me self
  let cohabitants other [gatherers] of my-home
  ask cohabitants [
    if not my-kin-link-neighbor? me 
    [create-my-kin-link-with me
    ;print (word "i have kin link " self me)
    ]
  ]
  if not displaced?
  [
    let #kin-houses 5
    repeat #kin-houses [
      let kin other [gatherers] of one-of other homes
      ask kin
      [
        if not my-kin-link-neighbor? me 
        [
          create-my-kin-link-with me
          ;print (word "i have extended kin link " self me)
        ]
      ]
    ]
  ]
]
end


;;FRIENDS

;; Everyone this person could still befriend.
;;
;; Anyone in the world who is not already a friend, and not the person themselves.
;; The commented-out body above restricts candidates to people met at church or
;; school, which is the intended version once those places are populated.
;;
;; @context person
;; @return agentset of people not yet linked by `my-friends-links`
to-report possible-friends
 ; let agents-to-befriend reduce [ [x y] -> (turtle-set x y) ] ([gatherers] of (turtle-set my-church my-school))
  ;report other agents-to-befriend with [not my-friends-link-neighbor? myself ] ;and age = [age] of myself]
  report other people with [not my-friends-link-neighbor? myself ]
end

;; Give every person up to three friends drawn at random from the whole population.
;; @context observer
;; @side-effects creates `my-friends-links`
to setup-friends-networks
  
  ;ask children with [any? [gatherers with [is-adult?]] of my-home ][create-dependable-adult-link-to one-of [gatherers with [is-adult?]] of my-home ]
  ;  ask workers [  create-workplace-colleague-links-to other workers with [my-workplace = [my-workplace] of myself]]
  ask people [
    ;everyone has the same n of friends
    ; Its up to n so this does not throw an error if there are not enough agents to become friends with
    create-my-friends-links-with up-to-n-of 3 possible-friends
  ]
  
end


;;COLLEAGUES

;; The other people hired by this person's workplace.
;;
;; @context person
;; @return agentset of people, excluding self; empty for anyone who is not a worker
to-report my-colleagues
  ;report other [hired-workers] of my-work
  ;report workplace-colleague-link-neighbors
  let my-wp my-workplace
  if my-wp != nobody [
     report other [gatherers with [my-workplace = my-wp]] of my-wp
   ]
   report (turtle-set nobody)
end


;;TRUSTEES

to setup-trust-network
  ;establish trust towards priest
ask people with [priest? = false][
if my-church != nobody [
  let my-priest one-of people with [priest?] ;and [gathering-type] of my-work = my-church] PUT THIS BACK, OTHERWISE WE TRUST RANDOM PRIESTS
  create-my-trustee-link-to my-priest
  print "trusting my priest"
 ]
]

  ask people with [displaced? = true] [
    let trustee one-of other [gatherers] of my-home
  create-my-trustee-link-to trustee
  print "trusting one of my cohabitants"
  ]

ask my-trustees-links [set color blue]

end


to update-trustees
;;HERE IS WHERE WE INCLUDE PEOPLE IN OUR TRUSTED SOURCES OF INFORMATION DEPENDING ON PAST EVENT (e.g. has a healthcare worker saved a relative?)
end




;;REPORTERS

;; The people this person is linked to by `my-friends-links`.
;; @context person
;; @return agentset of people
to-report my-friends
  report my-friends-link-neighbors
end

;; The other people living in this person's home.
;; @context person
;; @return agentset of people, excluding self
to-report my-relatives
  report my-kin-link-neighbors
end

;; Everyone this person knows: relatives, colleagues and friends together.
;; @context person
;; @return agentset of people, with duplicates across the three groups collapsed
;; @see my-relatives
;; @see my-colleagues
;; @see my-friends
to-report my-network
  report (turtle-set my-relatives my-colleagues my-friends)
end

to-report my-sick-relatives
  report my-relatives with [is-observing-critical-symptoms?] 
end

to-report my-networks-homes
  report [my-home] of my-relatives
end



to-report my-trustees
  report people ;with [trusted?] in my-network
end




;;LEGACY COVID


;; The people who depend on this person, through `dependable-adult-links`.
;;
;; @context person
;; @return agentset of people
;;to-report people-that-depend-on-me
;;  report in-dependable-adult-link-neighbors
;;end

;; Everyone of working age.
;;
;; @return agentset of people
;; @note Empty in the current build: nothing assigns `age`.
to-report workers
  report people with [is-worker?]
end

;; True when this person is of the "young" age class.
;;
;; @context person
;; @return true if `age` is "young"
;; @note Never true in the current build: nothing assigns `age`.
to-report is-child?
  report age = "young"
end

;; Everyone of student age.
;;
;; @return agentset of people
;; @note Empty in the current build: nothing assigns `age`.
to-report students
  report people with [ is-student?]
end

;; True when this person is a student or a worker.
;;
;; Retirees were part of this test in the COVID model and are commented out.
;;
;; @context person
;; @return true if `age` is "student" or "worker"
;; @note Never true in the current build: nothing assigns `age`.
to-report is-adult?
  report is-student? or is-worker?
end

;; True when this person is of the "student" age class.
;;
;; @context person
;; @return true if `age` is "student"
;; @note Never true in the current build: nothing assigns `age`.
to-report is-student?
  report age = "student"
end

;; True when this person is of the "worker" age class.
;;
;; @context person
;; @return true unless unemployed
;; @note Always true in the current build
;; age is commented out in people/classes.nls.
to-report is-worker?
  ifelse my-work != nobody
  [report true] [
    error "behaviour for unenployed people not implemented"
    ]
end


;; Export the friendship network to `file` as a Graphviz undirected graph.
;;
;; Each link is written once, ordered by `who` so the output is stable between
;; runs with the same seed.
;;
;; @param file  path of the file to write
;; @context observer
;; @side-effects deletes `file` if it already exists, then rewrites it
;; @example
;; write-network-to-file "friends.dot"
to write-network-to-file [file]
  if file-exists? file [file-delete file]
  file-open file
  file-print "graph {"
  file-print "graph [overlap=false];"
  file-print "node [style=filled];"
  ask my-friends-links [
    let turtle1 min-one-of both-ends [who]
    let turtle2 max-one-of both-ends [who]
    file-print (word "\"" [who] of turtle1 "\" -- \"" [who] of turtle2 "\";") 
  ]
  file-print "}"
  file-close
end