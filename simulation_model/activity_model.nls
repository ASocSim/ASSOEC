;; The motive recorded when a person tags along with whoever is looking after them.
;;
;; @return the string "follow person in charge"
;; @see perform-people-activities
to-report follow-person-in-charge-motive
  report "follow person in charge"
end


;; True when this person owes work time on this tick: a working-age adult, on a
;; weekday, in the morning or afternoon.
;;
;; @context person
;; @return true if this person should be at work now
;; @note Never true in the current build: nothing assigns `age`.
to-report is-I-have-contractual-obligations?
  report age = "worker" and (slice-of-the-day = "morning" or slice-of-the-day = "afternoon")
  and not (day-of-the-week = "saturday" or day-of-the-week = "sunday")
end

;; True when the descriptor means "rest at my own home".
;;
;; @param an-activity-descriptor  the descriptor to test
;; @context person
;; @return true if the descriptor pairs `my-home` with the "rest" motive
to-report is-rest-at-home-descriptor? [an-activity-descriptor]
  report location-of an-activity-descriptor = my-home and motive-of an-activity-descriptor = "rest"
end

;; True when this person is resting and is at their own home.
;;
;; @context person
;; @return true if resting at `my-home`
to-report is-resting-at-home?
  report is-resting?
  and is-at-home?
end

;; True when this person's current motive is rest.
;;
;; @context person
;; @return true if `current-motivation` is "rest"
to-report is-resting?
  report current-motivation = "rest"
end

;; True when this person's current motive is leisure.
;;
;; @context person
;; @return true if `current-motivation` is "relaxing"
;; @note The Ebola build never offers a "relaxing" activity, so this is currently
;; always false.
to-report is-relaxing?
  report current-motivation = "relaxing"
end

;; True when this person is at their own home.
;;
;; @context person
;; @return true if `current-activity` is `my-home`
;; @note `current-activity` holds a place, not an activity - the motive is kept
;; separately in `current-motivation`.
to-report is-at-home?
  report  current-activity = my-home
end

;; True when this person is at a school under compulsion.
;;
;; @context person
;; @return true if at a school with the "mandatory" motive
to-report is-forced-to-be-in-school?
  report [gathering-type] of current-activity = "school" and current-motivation = "mandatory"
end

;; True when this person's current motive is learning.
;;
;; @context person
;; @return true if `current-motivation` is `learning-motive`
to-report is-learning?
  report current-motivation = learning-motive
end



;; True when this person's current motive is being tested.
;;
;; @context person
;; @return true if `current-motivation` is "get-tested"
to-report is-getting-tested?
  report current-motivation = "get-tested"
end

