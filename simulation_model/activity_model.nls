to-report is-performing-essential-shopping?
  report is-essential-shop-gathering-point? current-motivation
end

;; Work in progress.
;;
;; work in progress
;;
;; @param a-gathering-point  work in progress
;; @return work in progress
;; @todo Named for a gathering point but compares against a motive string. See
;; docs/WIP_ISSUES.md#is-performing-essential-shopping--and-is-essential-shop-gathering-point-.
to-report is-essential-shop-gathering-point? [a-gathering-point]
  report a-gathering-point = "essential shopping"
end


;; True when this person's current motive is shopping of either kind.
;;
;; @context person
;; @return true if the motive is essential or non-essential shopping
;; @see is-a-shopping-motivation?
to-report is-performing-shopping?
  report is-a-shopping-motivation? current-motivation
end


;; True when this person is shopping for non-essentials, at a non-essential shop.
;;
;; @context person
;; @return true if both the motive and the place are non-essential
;; @note Never true in the Ebola build, which creates no "non-essential-shop"
;; gathering points.
to-report is-performing-non-essential-shopping?
  report is-a-non-essential-shopping-motivation? current-motivation and
  is-a-non-essential-gathering-point? current-activity
end

;; True when `a-gathering-point` is a non-essential shop.
;;
;; @param a-gathering-point  the place to test
;; @return true if its `gathering-type` is "non-essential-shop"
;; @note The Ebola build creates no such places.
to-report is-a-non-essential-gathering-point? [a-gathering-point]
  report [gathering-type] of a-gathering-point = "non-essential-shop"
end

;; True when `a-motive` is shopping for non-essentials.
;;
;; @param a-motive  the motive string to test
;; @return true if the motive is "shopping"
to-report is-a-non-essential-shopping-motivation? [a-motive]
  report  a-motive = "shopping"
end

;; True when `a-motive` is shopping of either kind.
;;
;; @param a-motive  the motive string to test
;; @return true if the motive is essential or non-essential shopping
to-report is-a-shopping-motivation? [a-motive]
  report is-essential-shop-gathering-point? a-motive or
  is-a-non-essential-shopping-motivation? a-motive
end

;; How much food this person buys in one shopping trip.
;;
;; Enough to feed everyone in their household for the configured number of days.
;;
;; @context person
;; @return a number of rations
;; @unit person-days of food
to-report amount-of-rations-I-buy-when-going-to-essential-shops
  report days-of-rations-bought * count [gatherers] of my-home
end

;; True when `a-motive` is leisure.
;;
;; @param a-motive  the motive string to test
;; @return true if the motive is "relaxing"
to-report is-a-leisure-motivation? [a-motive]
  report a-motive = "relaxing"
end

;; True when `a-motive` is the work motive.
;;
;; @param a-motive  the motive string to test
;; @return true if the motive is "contractual obligation"
;; @see is-working-motive?
to-report  is-contractual-obligation? [a-motive]
  report a-motive = "contractual obligation"
end

;; True when `location` is a home.
;;
;; @param location  the place to test
;; @return true if its `gathering-type` is "home"
to-report is-home-gathering-point? [location]
  report [gathering-type] of location = "home"
end

;; Whether a child in someone's care could be brought along to this activity.
;;
;; Anything at a home, a hospital test, shopping, leisure and treatment can be
;; done with a dependant in tow. Work and school cannot. Anything else raises an
;; error rather than guessing, so that a new activity type is noticed here.
;;
;; @param an-activity-descriptor  the activity being considered
;; @return true if a dependant can come along
;; @context person
;; @side-effects raises an error for any descriptor the rules above do not cover
to-report can-be-done-with-a-dependable-person? [an-activity-descriptor]
  if
  is-home-gathering-point? location-of an-activity-descriptor
  or ([is-hospital?] of first an-activity-descriptor and motive-of an-activity-descriptor = "get-tested")
  or (is-a-shopping-motivation? motive-of an-activity-descriptor)
  or (is-a-leisure-motivation? motive-of an-activity-descriptor)
  or motive-of an-activity-descriptor = treatment-motive
  [report true]

  if
  ([ is-hospital? or is-workplace? or is-store? or is-school?] of location-of an-activity-descriptor)
  and (motive-of an-activity-descriptor = learning-motive or
    is-contractual-obligation? motive-of an-activity-descriptor)
  [report false]

  error (sentence "unimplemented" [gathering-type] of first an-activity-descriptor last an-activity-descriptor)
end

;; Work in progress.
;;
;; work in progress
;;
;; @context work in progress
;; @side-effects work in progress
;; @todo The capacity pass selects the people whose activity is *not* here, and
;; the procedure still prints and resets the timer every tick. See
;; docs/WIP_ISSUES.md#perform-people-activities.
to perform-people-activities
  reset-timer
  print (sentence "performing activities for" count people "people")
  ask people [
    if not is-being-away? current-activity and current-motivation = travelling-motive [error "wrong place while travelling"]
    select-activity
    if not is-being-away? current-activity and current-motivation = travelling-motive [error (sentence "wrong place while travelling" current-activity current-motivation)]

    if is-currently-in-situation-of-active-dependence? and current-person-I-depend-on != nobody
    [
      set current-activity [current-activity] of current-person-I-depend-on
      set current-motivation follow-person-in-charge-motive
    ]
  ]

  ;travelling-to-activity-phase
  
  ask people with [[capacity = disabled-capacity] of current-activity or not [is-operating?] of current-activity] [
    set is-activity-successful? true
  ]
  
  ask gathering-points with [capacity != disabled-capacity] [
    ;error "why?"
    ;ask gatherers [show myself show current-activity]
    let all-people (gatherers with [current-activity != myself])
    ifelse count all-people > current-capacity [
      let succesful-people n-of current-capacity all-people
      ask succesful-people [set is-activity-successful? true]
      ask all-people with [not member? self succesful-people] [
        set is-activity-successful? false
      ]
    ] [
      ask all-people [ set is-activity-successful? true ]
    ]
  ]

  ask people [
    if not is-being-away? current-activity and current-motivation = travelling-motive [error (sentence "wrong place while travelling" current-activity current-motivation)]
    execute-activity-effect
    update-needs-for-playing (list current-activity current-motivation is-I-apply-social-distancing?)
  ]
  animate-walk-to-goal

end

;; True when the descriptor means "go to a hospital to be treated".
;;
;; @param an-activity-descriptor  the descriptor to test
;; @return true if the place is a hospital and the motive is `treatment-motive`
to-report is-get-healed-to-hospital-descriptor? [an-activity-descriptor]
  report [is-hospital?] of location-of an-activity-descriptor and motive-of an-activity-descriptor = treatment-motive
end

;; Whether this place is running at all.
;;
;; A place counts as operating as soon as anyone is hired there, whether or not
;; the staff turned up on this tick.
;;
;; @context gathering-point
;; @return true if the place has at least one hired worker
;; @todo Loose definition, to be tightened once staffing matters.
to-report is-operating?
  report any? hired-workers
end











