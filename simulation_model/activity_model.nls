;; @file activity_model.nls
;; @brief Activity descriptors, the predicates that ask what a person is doing,
;; and the tick loop that makes everyone do it.
;;
;; An *activity descriptor* is the unit of choice in this model: a small list
;; pairing a gathering point with a motive, built by `activity-descriptor` and
;; read back with `location-of` and `motive-of`. `select_activity.nls` offers a
;; person the descriptors available to them, `need_management.nls` scores them,
;; and `perform-people-activities` here carries out the winner.
;;
;; Most of the file is one-line predicates over `current-activity` and
;; `current-motivation`, so that the rest of the model can ask "is this person at
;; work?" without knowing how that is stored.
;;
;; @note Motive strings are in transition. motives.nls defines constants
;; (`work-motive` is "contractual obligation"), while `select_activity.nls`
;; records bare strings such as "work". Predicates below that test the constants
;; therefore never fire on descriptors the Ebola build actually produces.
;; @see decision/select_activity.nls
;; @see motives.nls
;; @see docs/WIP_ISSUES.md

__includes ["motives.nls" "transport.nls"]

;; Apply the consequences of the activity this person has just performed.
;;
;; Hospital beds are claimed and released here: a person who is being treated
;; takes a bed if they have none, and anyone holding a bed for any other reason
;; gives it back. An activity the person was turned away from has no further
;; effect. Otherwise the activity updates what the person believes.
;;
;; @context person
;; @side-effects acquires or releases a hospital bed, and updates beliefs
;; @see update-belief-based-on-current-activity
to execute-activity-effect
  if is-currently-allocated-a-bed-in-hospital? and not (current-motivation = treatment-motive) [
    release-bed-in-hospital
  ]
  if not is-currently-allocated-a-bed-in-hospital? and (current-motivation = treatment-motive)
  [
    try-acquire-a-bed-in-hospital
  ]
  if ( not is-activity-successful? )
  [
    stop
  ]

;  update-resources-based-on-current-activity

  ;might be interesting to hold this variable as an integer, for storing when the next shopping will be needed
  ;additionally, we might want at some point to hold additional variables within homes (i.e. one person getting the food for the whole community)

  ;the epistemic infection status depends on whether the person has (had) visible symptoms, not on where it now gathers
  ;though, gathering place might be to be recorded (i.e. a "maybe infected" state if public space has been visited and public space is believed to be contagious)
  ;if [gathering-type] of current-activity = "hospital"
  ;[ set epistemic-infection-status  infection-status ]

  update-belief-based-on-current-activity

end

;; Build an activity descriptor: a place paired with a reason for being there.
;;
;; This is the only supported way to construct a descriptor, and it checks that
;; the place really is a gathering point rather than, say, a bare string.
;;
;; @param a-gathering-point  where the activity happens
;; @param a-motive           why the person would go there
;; @return a two-element list, read back with `location-of` and `motive-of`
;; @see location-of
;; @see motive-of
;; @note Descriptors gain a third element - a social-distancing flag - only later,
;; where `my-available-activity-descriptors` appends `false` to each of them.
to-report activity-descriptor [a-gathering-point a-motive]
  if not is-gathering-point? a-gathering-point [error (sentence a-gathering-point "should be a gathering point")]

  report (list a-gathering-point a-motive)
end

;; The place an activity descriptor refers to.
;;
;; @param an-activity-descriptor  the descriptor to read
;; @return a gathering point
;; @note Named for its position in the descriptor rather than for its type; it
;; always reports a gathering point.
to-report location-of [an-activity-descriptor]
  report item 0 an-activity-descriptor
end

;; The reason an activity descriptor gives for going somewhere.
;;
;; @param an-activity-descriptor  the descriptor to read
;; @return a motive string
to-report motive-of [an-activity-descriptor]
  report item 1 an-activity-descriptor
end

;; Work in progress.
;;
;; work in progress
;;
;; @param an-activity-descriptor  work in progress
;; @return work in progress
;; @todo Reads a third element that `activity-descriptor` never creates. See
;; docs/WIP_ISSUES.md#social-distancing-of.
to-report social-distancing-of [an-activity-descriptor]
  report item 2 an-activity-descriptor
end

