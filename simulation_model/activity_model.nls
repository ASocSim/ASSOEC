;; True when this person is at their current place under compulsion.
;;
;; @context person
;; @return true if `current-motivation` is the "mandatory" motive
to-report is-forced-to-be-here?
  report is-forced-motive? current-motivation
end

;; True when `a` is the abroad placeholder gathering point.
;;
;; @param a  a gathering point
;; @return true if `a` is `away-gathering-point`
to-report is-being-away? [a]
  report a = away-gathering-point
end

;; True when this person is working and is at their own workplace.
;;
;; @context person
;; @return true if working, at `my-work`
;; @see is-working?
to-report is-working-at-work?
  report is-working? and is-at-work?
end

;; True when this person's current motive is work.
;;
;; @context person
;; @return true if `current-motivation` is `work-motive`
;; @note Never true in the current build: `work-motive` is "contractual
;; obligation" while `select-activity` records the motive as "work".
to-report is-working?
  report is-working-motive? current-motivation
end

;; True when `a-motive` is the work motive.
;;
;; @param a-motive  the motive string to test
;; @return true if the motive is "contractual obligation"
;; @note Duplicates `is-contractual-obligation?`, and both test the literal string
;; rather than calling `work-motive`.
;; @see is-contractual-obligation?
to-report is-working-motive? [a-motive]
  report a-motive = "contractual obligation"
end

;; How many workers are working right now, anywhere.
;;
;; @return a count of people
;; @note 0 in the current build, on both counts: `workers` is gated on `age`,
;; which nothing assigns, and `is-working?` tests a motive string the Ebola build
;; never produces.
to-report #workers-working
  report count workers with [is-working?]
end

;;;WORKERS AT EACH WORKING PLACE


;; How many workers are working at a hospital right now.
;;
;; @return a count of people
;; @see #workers-working
to-report #workers-working-at-hospital
  report count workers with [is-working? and [gathering-type] of my-work = "hospital"]
end

